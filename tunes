#!/usr/bin/env bash
# tunes — search, play, queue, and manage music & podcasts from the terminal
# Features: GNOME Notification & MPRIS2 controls, background playback, playlists, Ollama AI recs, and offline downloads.
# Deps: mpv, yt-dlp, fzf, python3, curl, jq  |  optional: playerctl (media keys), sptlrx (lyrics), Ollama (recommend/mood)

set -euo pipefail

DATA_DIR="$HOME/.local/share/tunes"
PLAYLISTS_DIR="$DATA_DIR/playlists"
SCRIPTS_DIR="$DATA_DIR/scripts"
HISTORY_FILE="$DATA_DIR/history.tsv"
FAVORITES_FILE="$DATA_DIR/favorites.tsv"
DOWNLOAD_DIR="$HOME/Music/tunes-downloads"
POD_DOWNLOAD_DIR="$DOWNLOAD_DIR/Podcasts"
FEEDS_FILE="$DATA_DIR/feeds.tsv"                 # name\turl
POD_HISTORY_FILE="$DATA_DIR/podcast_history.tsv"  # title\turl\tfeed_name

RUNTIME_BASE="${XDG_RUNTIME_DIR:-/tmp}"
MPV_SOCKET="${RUNTIME_BASE}/tunes-mpv-${UID:-$(id -u)}.sock"

OLLAMA_URL="${OLLAMA_URL:-http://localhost:11434}"
OLLAMA_MODEL="${OLLAMA_MODEL:-llama3.2:3b}"

mkdir -p "$DATA_DIR" "$PLAYLISTS_DIR" "$SCRIPTS_DIR" "$DOWNLOAD_DIR" "$POD_DOWNLOAD_DIR"
touch "$HISTORY_FILE" "$FAVORITES_FILE" "$FEEDS_FILE" "$POD_HISTORY_FILE"

# ---------- helpers & dependency verification ----------

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "Missing dependency: $1" >&2; exit 1; }
}
need mpv
need yt-dlp
need fzf
need python3
need curl
need jq

# Ensure GNOME desktop file and MPRIS/notify scripts are installed
ensure_gnome_integration() {
  local apps_dir="$HOME/.local/share/applications"
  local desktop_file="$apps_dir/tunes.desktop"
  if [[ ! -f "$desktop_file" ]]; then
    mkdir -p "$apps_dir"
    cat <<'EOF' > "$desktop_file"
[Desktop Entry]
Name=Tunes
GenericName=Terminal Music Player
Comment=Terminal music and podcast player with GNOME controls
Exec=tunes search
Icon=audio-headphones
Terminal=true
Type=Application
Categories=AudioVideo;Audio;Player;
Keywords=music;podcast;audio;player;mpv;yt-dlp;
StartupNotify=false
EOF
    if command -v update-desktop-database >/dev/null 2>&1; then
      update-desktop-database "$apps_dir" 2>/dev/null || true
    fi
  fi

  # Ensure mpv lua notification script exists
  local notify_script="$SCRIPTS_DIR/tunes-notify.lua"
  if [[ ! -f "$notify_script" ]]; then
    cat <<'EOF' > "$notify_script"
local mp = require 'mp'

local function notify_track()
    local title = mp.get_property("media-title")
    if not title or title == "" or title == "mpv" then return end

    local artist = mp.get_property("metadata/by-key/artist") or ""
    local uploader = mp.get_property("metadata/by-key/uploader") or ""
    if artist == "" and uploader ~= "" then
        artist = uploader
    end

    local pos = mp.get_property_number("playlist-pos-1", 1)
    local total = mp.get_property_number("playlist-count", 1)

    local header = "Now Playing"
    if total and total > 1 then
        header = string.format("Now Playing (%d/%d)", pos, total)
    end

    local body = title
    if artist ~= "" and not string.find(title, artist, 1, true) then
        body = artist .. " — " .. title
    end

    mp.command_native_async({
        name = "subprocess",
        playback_only = false,
        capture_stdout = true,
        args = {
            "notify-send",
            "-a", "Tunes",
            "-i", "audio-headphones",
            "-h", "string:desktop-entry:tunes",
            "-t", "5000",
            "-A", "pause=⏯ Play/Pause",
            "-A", "next=⏭ Next",
            header,
            body
        }
    }, function(success, res, err)
        if success and res and res.stdout then
            local action = res.stdout:gsub("%s+", "")
            if action == "pause" then
                mp.commandv("cycle", "pause")
            elseif action == "next" then
                mp.commandv("playlist-next")
            end
        end
    end)
end

mp.register_event("file-loaded", notify_track)
EOF
  fi

  # Auto-load mpris.so into mpv user config if available
  local mpv_scripts_dir="$HOME/.config/mpv/scripts"
  if [[ -f "$SCRIPTS_DIR/mpris.so" && ! -f "$mpv_scripts_dir/mpris.so" ]]; then
    mkdir -p "$mpv_scripts_dir"
    cp "$SCRIPTS_DIR/mpris.so" "$mpv_scripts_dir/mpris.so" 2>/dev/null || true
  fi
}
ensure_gnome_integration

# Robust IPC sender using Python AF_UNIX socket
# Usage: mpv_ipc '["command", "arg"]' [wait_response: 0|1]
mpv_ipc() {
  local cmd_json="$1" wait_resp="${2:-0}"
  if [[ ! -S "$MPV_SOCKET" ]]; then
    return 1
  fi
  python3 - "$MPV_SOCKET" "$cmd_json" "$wait_resp" <<'PYEOF'
import sys, socket, json

sock_path = sys.argv[1]
try:
    cmd = json.loads(sys.argv[2])
except Exception:
    sys.exit(1)

wait_resp = sys.argv[3] == "1"

try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(1.0)
    s.connect(sock_path)
    s.sendall(json.dumps({"command": cmd}).encode('utf-8') + b"\n")
    s.shutdown(socket.SHUT_WR)
    resp = s.recv(4096)
    s.close()
    if wait_resp and resp:
        data = json.loads(resp.decode('utf-8', errors='ignore'))
        val = data.get("data")
        if val is not None:
            if isinstance(val, bool):
                print("true" if val else "false")
            else:
                print(val)
    sys.exit(0)
except Exception:
    sys.exit(1)
PYEOF
}

# Wrapper for desktop notifications
desktop_notify() {
  local summary="$1" body="${2:-}" icon="${3:-audio-headphones}" extra_args=("${@:4}")
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Tunes" -i "$icon" -h "string:desktop-entry:tunes" "${extra_args[@]}" "$summary" "$body" 2>/dev/null || true
  fi
}

cleanup_stale_socket() {
  if [[ -S "$MPV_SOCKET" ]]; then
    if ! mpv_ipc '["get_property", "pid"]' 0 >/dev/null 2>&1; then
      rm -f "$MPV_SOCKET"
    fi
  fi
}

# Checks Ollama is reachable; prints a helpful message once if not.
ollama_available() {
  curl -s --max-time 2 "${OLLAMA_URL}/api/tags" >/dev/null 2>&1
}

# Sends a prompt to the local model, returns raw text response on stdout.
llm_ask() {
  local system="$1" user="$2"
  if ! ollama_available; then
    echo "⚠ Ollama not reachable at ${OLLAMA_URL} (is it running?)" >&2
    return 1
  fi
  python3 - "$OLLAMA_URL" "$OLLAMA_MODEL" "$system" "$user" <<'PYEOF'
import sys, json, urllib.request
url, model, system, user = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
payload = {
    "model": model,
    "prompt": user,
    "system": system,
    "stream": False,
    "options": {"temperature": 0.7}
}
req = urllib.request.Request(
    url.rstrip('/') + "/api/generate",
    data=json.dumps(payload).encode(),
    headers={"Content-Type": "application/json"}
)
try:
    with urllib.request.urlopen(req, timeout=30) as resp:
        data = json.loads(resp.read().decode())
        print(data.get("response", "").strip())
except Exception as e:
    print(f"__LLM_ERROR__ {e}", file=sys.stderr)
    sys.exit(1)
PYEOF
}

YTDL_ARGS="--ytdl-format=bestaudio/best --ytdl-raw-options=extractor-args=youtube:player_client=android"

# Strip common YouTube title clutter so lyrics tools (sptlrx) can match artist/title.
clean_title() {
  local t="$1"
  t=$(sed -E '
    s/[\(\[][^)\]]*(official|video|audio|lyrics?|hd|hq|4k|visualizer|remastered|mv|m\/v)[^)\]]*[\)\]]//Ig;
    s/\s*[-–]\s*(Topic)\s*$//I;
    s/\bft\.?\s+/feat. /Ig;
    s/\s{2,}/ /g;
    s/^\s+|\s+$//g;
    s/\s*[-–]\s*$//
  ' <<< "$t")
  echo "$t"
}

# Safely deduplicate TSV files by exact URL match (column 2)
dedupe_tsv_by_url() {
  local file="$1" url="$2"
  [[ ! -f "$file" ]] && return 0
  awk -F'\t' -v u="$url" '$2 != u' "$file" > "$file.tmp" 2>/dev/null || true
  mv "$file.tmp" "$file"
}

log_history() {
  local title="$1" url="$2"
  dedupe_tsv_by_url "$HISTORY_FILE" "$url"
  { echo -e "${title}\t${url}"; cat "$HISTORY_FILE" 2>/dev/null; } > "$HISTORY_FILE.tmp"
  mv "$HISTORY_FILE.tmp" "$HISTORY_FILE"
  # keep last 200
  head -n 200 "$HISTORY_FILE" > "$HISTORY_FILE.tmp" && mv "$HISTORY_FILE.tmp" "$HISTORY_FILE"
}

# Build common mpv script arguments (MPRIS2 and Notification integration)
get_mpv_script_args() {
  local args=()
  local notify_script="$SCRIPTS_DIR/tunes-notify.lua"
  local mpris_script="$SCRIPTS_DIR/mpris.so"
  if [[ -f "$notify_script" ]]; then
    args+=("--scripts-add=$notify_script")
  fi
  # If mpris.so is not already in ~/.config/mpv/scripts, load it explicitly
  if [[ -f "$mpris_script" && ! -f "$HOME/.config/mpv/scripts/mpris.so" ]]; then
    args+=("--scripts-add=$mpris_script")
  fi
  echo "${args[@]}"
}

play_url() {
  local title="$1" url="$2" clean loop_flag=""
  clean=$(clean_title "$title")
  log_history "$title" "$url"
  cleanup_stale_socket

  [[ "${LOOP:-0}" == "1" ]] && loop_flag="--loop-file=inf"
  local script_args; script_args=$(get_mpv_script_args)

  if [[ "${DETACH:-0}" == "1" ]]; then
    echo "▶ Playing in background: $clean$( [[ -n "$loop_flag" ]] && echo ' (looping)' )"
    nohup mpv --no-video --input-ipc-server="$MPV_SOCKET" \
        $script_args \
        $YTDL_ARGS \
        --force-media-title="$clean" \
        $loop_flag \
        "$url" > "$DATA_DIR/tunes.log" 2>&1 &
    local pid=$!
    disown "$pid"
    desktop_notify "Now Playing (Background)" "$clean" "audio-headphones"
    echo "  (Process PID: $pid. Use 'tunes status' or 'tunes ctl' to control playback)"
  else
    echo "▶ Playing: $clean$( [[ -n "$loop_flag" ]] && echo ' (looping)' )"
    mpv --no-video --input-ipc-server="$MPV_SOCKET" \
        $script_args \
        $YTDL_ARGS \
        --force-media-title="$clean" \
        $loop_flag \
        --term-osd-bar \
        "$url"
  fi
}

search_and_pick() {
  local query="$1" count="${2:-15}"
  echo "Searching: $query ..." >&2
  yt-dlp "ytsearch${count}:${query}" --flat-playlist -j 2>/dev/null \
    | jq -r '"\(.title)\t\(.url // ("https://www.youtube.com/watch?v=" + .id))\t\(.channel // .uploader // "")\t\(.duration_string // "")"'
}

pick_from_list() {
  local prompt="${1:-🎵 > }"
  # reads tab-separated title\turl[\tchannel\tduration] from stdin
  fzf --delimiter='\t' --with-nth=1,3,4 \
      --prompt="$prompt" --height=60% --border --reverse \
      --preview='echo -e "Title:    \033[1m{1}\033[0m\nChannel:  {3}\nDuration: {4}\nURL:      {2}"' \
      --preview-window="down:4:wrap:hidden" --bind="?:toggle-preview"
}

# ---------- word-frequency helper (used by recommend) ----------
top_words() {
  local n="${1:-3}"
  tr '[:upper:]' '[:lower:]' \
    | tr -c 'a-z0-9' '\n' \
    | grep -vE '^(the|and|feat|ft|official|video|audio|lyrics|remix|mv|hd|hq|with|for|from|of|to|in|on|a|an|is|by|ep|vol|part|full|album|song|music|podcast|episode)$' \
    | awk 'length($0)>2' \
    | sort | uniq -c | sort -rn \
    | head -n "$n" | awk '{print $2}'
}

# Cleans up numbered/bulleted/quoted LLM output into plain lines, capped at N.
llm_lines_to_list() {
  local n="${1:-5}"
  sed -E 's/^[[:space:]]*[-*0-9.)]+[[:space:]]*//' \
    | sed -E 's/^"(.*)"$/\1/' \
    | grep -v '^\s*$' \
    | head -n "$n"
}

# ---------- podcast helpers (RSS via python3, no extra deps) ----------

# Parses an RSS feed URL, prints title\tenclosure_url\tfeed_name\tpubdate per episode
pod_parse_feed() {
  local url="$1" limit="${2:-30}" feed_name="${3:-}"
  curl -sL --max-time 15 "$url" 2>/dev/null | python3 <(cat <<'PYEOF'
import sys, xml.etree.ElementTree as ET
limit = int(sys.argv[1])
feed_name = sys.argv[2] if len(sys.argv) > 2 else ""
data = sys.stdin.buffer.read()
try:
    root = ET.fromstring(data)
except Exception:
    sys.exit(0)

if not feed_name:
    ch_title = root.find('.//channel/title')
    feed_name = (ch_title.text or '').strip().replace('\t', ' ') if ch_title is not None else 'Podcast'

items = root.findall('.//item')[:limit]
for it in items:
    title_el = it.find('title')
    title = (title_el.text or '').strip().replace('\t', ' ') if title_el is not None else 'Untitled'
    enc = it.find('enclosure')
    link = enc.get('url') if enc is not None and enc.get('url') else None
    if not link:
        link_el = it.find('link')
        link = link_el.text.strip() if link_el is not None and link_el.text else None
    pub_el = it.find('pubDate')
    pub = (pub_el.text or '').strip() if pub_el is not None else ''
    if link:
        print(f"{title}\t{link}\t{feed_name}\t{pub}")
PYEOF
) "$limit" "$feed_name" 2>/dev/null || true
  return 0
}

# iTunes Search API lookup (free, no key) -> name\tfeed_url
pod_itunes_search() {
  local query="$1" limit="${2:-10}"
  curl -sL --max-time 15 "https://itunes.apple.com/search?media=podcast&limit=${limit}&term=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$query")" 2>/dev/null \
    | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for r in data.get('results', []):
    name = (r.get('collectionName') or 'Unknown').replace('\t',' ')
    feed = r.get('feedUrl')
    if feed:
        print(f'{name}\t{feed}')
" 2>/dev/null || true
  return 0
}

# ---------- commands ----------

cmd_search() {
  local query="${1:-}"
  [[ -z "$query" ]] && read -rp "Search: " query
  [[ -z "$query" ]] && exit 0
  local selection
  selection=$(search_and_pick "$query" | pick_from_list "🎵 > ") || { echo "Cancelled."; exit 0; }
  [[ -z "$selection" ]] && exit 0
  local title url
  title=$(cut -f1 <<<"$selection")
  url=$(cut -f2 <<<"$selection")
  play_url "$title" "$url"
}

cmd_queue() {
  # multi-select search -> builds an mpv playlist
  local query="${1:-}"
  [[ -z "$query" ]] && read -rp "Search (queue mode): " query
  [[ -z "$query" ]] && exit 0
  local selections
  selections=$(search_and_pick "$query" | fzf --multi --delimiter='\t' --with-nth=1,3,4 \
      --prompt="🎵 select multiple (tab) > " --height=60% --border --reverse \
      --preview='echo -e "Title:    \033[1m{1}\033[0m\nChannel:  {3}\nDuration: {4}\nURL:      {2}"' \
      --preview-window="down:4:wrap:hidden" --bind="?:toggle-preview") || exit 0
  [[ -z "$selections" ]] && exit 0

  local playlist_file; playlist_file=$(mktemp /tmp/tunes-queue-XXXX.m3u)
  local count=0
  while IFS=$'\t' read -r title url channel duration; do
    [[ -z "$url" ]] && continue
    local clean; clean=$(clean_title "$title")
    log_history "$title" "$url"
    { echo "#EXTINF:-1,${clean}"; echo "$url"; } >> "$playlist_file"
    count=$((count+1))
  done <<< "$selections"

  cleanup_stale_socket
  local loop_flag="" shuffle_flag=""
  [[ "${LOOP:-0}" == "1" ]] && loop_flag="--loop-playlist=inf"
  [[ "${SHUFFLE:-0}" == "1" ]] && shuffle_flag="--shuffle"
  local script_args; script_args=$(get_mpv_script_args)

  if [[ "${DETACH:-0}" == "1" ]]; then
    echo "▶ Playing queue of ${count} tracks in background"
    nohup mpv --no-video --input-ipc-server="$MPV_SOCKET" \
        $script_args $YTDL_ARGS $loop_flag $shuffle_flag "$playlist_file" > "$DATA_DIR/tunes.log" 2>&1 &
    local pid=$!
    disown "$pid"
    desktop_notify "Queue Started (Background)" "Playing ${count} tracks" "audio-headphones"
    echo "  (Process PID: $pid. Use 'tunes status' or 'tunes ctl' to control)"
  else
    echo "▶ Playing queue of ${count} tracks"
    mpv --no-video --input-ipc-server="$MPV_SOCKET" \
        $script_args $YTDL_ARGS $loop_flag $shuffle_flag --term-osd-bar "$playlist_file"
    rm -f "$playlist_file"
  fi
}

cmd_video() {
  local query="${1:-}"
  [[ -z "$query" ]] && read -rp "Search (video): " query
  [[ -z "$query" ]] && exit 0
  local selection
  selection=$(search_and_pick "$query" | pick_from_list "🎬 > ") || { echo "Cancelled."; exit 0; }
  [[ -z "$selection" ]] && exit 0
  local title url clean
  title=$(cut -f1 <<<"$selection")
  url=$(cut -f2 <<<"$selection")
  clean=$(clean_title "$title")
  log_history "$title" "$url"
  cleanup_stale_socket

  local loop_flag=""
  [[ "${LOOP:-0}" == "1" ]] && loop_flag="--loop-file=inf"
  local script_args; script_args=$(get_mpv_script_args)
  echo "▶ Playing (video): $clean"
  mpv --input-ipc-server="$MPV_SOCKET" \
      $script_args \
      $YTDL_ARGS \
      --force-media-title="$clean" \
      $loop_flag \
      "$url"
}

cmd_vlc() {
  local query="${1:-}"
  [[ -z "$query" ]] && read -rp "Search (VLC): " query
  [[ -z "$query" ]] && exit 0
  local selection
  selection=$(search_and_pick "$query" | pick_from_list "🟠 VLC > ") || { echo "Cancelled."; exit 0; }
  [[ -z "$selection" ]] && exit 0
  local title url clean resolved
  title=$(cut -f1 <<<"$selection")
  url=$(cut -f2 <<<"$selection")
  clean=$(clean_title "$title")
  log_history "$title" "$url"
  echo "Resolving stream URL..."
  resolved=$(yt-dlp -f "bestaudio/best" --extractor-args "youtube:player_client=android" -g "$url" 2>/dev/null | head -1 || true)
  [[ -z "$resolved" ]] && { echo "Failed to resolve stream."; exit 1; }
  local loop_flag=""
  [[ "${LOOP:-0}" == "1" ]] && loop_flag="--loop=-1"
  echo "▶ Opening in VLC: $clean"
  vlc --meta-title="$clean" $loop_flag "$resolved" >/dev/null 2>&1 &
  disown
}

# Direct play of URL, audio stream, local file or directory
cmd_play() {
  local target="${1:-}"
  [[ -z "$target" ]] && read -rp "URL or file path to play: " target
  [[ -z "$target" ]] && exit 0
  if [[ -f "$target" || -d "$target" ]]; then
    local name
    name=$(basename "$target")
    play_url "$name" "$target"
  else
    play_url "$target" "$target"
  fi
}

cmd_history() {
  [[ ! -s "$HISTORY_FILE" ]] && { echo "No history yet."; exit 0; }
  local selection
  selection=$(pick_from_list "🕒 History > " < "$HISTORY_FILE") || exit 0
  [[ -z "$selection" ]] && exit 0
  play_url "$(cut -f1 <<<"$selection")" "$(cut -f2 <<<"$selection")"
}

cmd_favorite_add() {
  [[ ! -s "$HISTORY_FILE" ]] && { echo "Nothing in history to favorite yet."; exit 0; }
  local selection
  selection=$(pick_from_list "★ Add Favorite > " < "$HISTORY_FILE") || exit 0
  [[ -z "$selection" ]] && exit 0
  local url
  url=$(cut -f2 <<<"$selection")
  dedupe_tsv_by_url "$FAVORITES_FILE" "$url"
  { echo "$selection"; cat "$FAVORITES_FILE" 2>/dev/null; } > "$FAVORITES_FILE.tmp"
  mv "$FAVORITES_FILE.tmp" "$FAVORITES_FILE"
  echo "★ Added to favorites: $(cut -f1 <<<"$selection")"
  desktop_notify "Favorites" "Added: $(cut -f1 <<<"$selection")" "emblem-favorite"
}

cmd_favorites() {
  [[ ! -s "$FAVORITES_FILE" ]] && { echo "No favorites yet. Use: tunes fav-add"; exit 0; }
  local selection
  selection=$(pick_from_list "★ Favorites > " < "$FAVORITES_FILE") || exit 0
  [[ -z "$selection" ]] && exit 0
  play_url "$(cut -f1 <<<"$selection")" "$(cut -f2 <<<"$selection")"
}

cmd_favorite_remove() {
  [[ ! -s "$FAVORITES_FILE" ]] && { echo "No favorites to remove."; exit 0; }
  local selection
  selection=$(pick_from_list "🗑 Remove Favorite > " < "$FAVORITES_FILE") || exit 0
  [[ -z "$selection" ]] && exit 0
  local url
  url=$(cut -f2 <<<"$selection")
  dedupe_tsv_by_url "$FAVORITES_FILE" "$url"
  echo "✔ Removed from favorites: $(cut -f1 <<<"$selection")"
}

cmd_download() {
  local query="${1:-}"
  [[ -z "$query" ]] && read -rp "Search to download: " query
  [[ -z "$query" ]] && exit 0
  local selection
  selection=$(search_and_pick "$query" | pick_from_list "⬇ Download > ") || exit 0
  [[ -z "$selection" ]] && exit 0
  local title url
  title=$(cut -f1 <<<"$selection")
  url=$(cut -f2 <<<"$selection")
  echo "⬇ Downloading to $DOWNLOAD_DIR ..."
  desktop_notify "Downloading Track" "$title" "emblem-downloads"
  yt-dlp -x --audio-format mp3 --audio-quality 0 \
    --embed-thumbnail --add-metadata \
    -o "${DOWNLOAD_DIR}/%(title)s.%(ext)s" "$url"
  echo "✔ Download complete: $DOWNLOAD_DIR"
  desktop_notify "Download Complete" "$title" "emblem-default"
}

cmd_lyrics() {
  if command -v sptlrx >/dev/null 2>&1; then
    sptlrx
  else
    echo "sptlrx not installed. It's a Go binary, not a pip package."
    echo "Install with: curl -sSL https://raw.githubusercontent.com/raitonoberu/sptlrx/main/install.sh | bash"
  fi
}

# Query playback status and show rich formatted output
cmd_status() {
  if ! mpv_ipc '["get_property", "playback-time"]' 0 >/dev/null 2>&1; then
    echo "Tunes is not currently playing."
    return 0
  fi
  python3 - "$MPV_SOCKET" <<'PYEOF'
import sys, socket, json

def query(prop):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.5)
        s.connect(sys.argv[1])
        s.sendall(json.dumps({"command": ["get_property", prop]}).encode('utf-8') + b"\n")
        s.shutdown(socket.SHUT_WR)
        resp = s.recv(4096)
        s.close()
        if resp:
            return json.loads(resp.decode('utf-8', errors='ignore')).get("data")
    except Exception:
        pass
    return None

title = query("media-title") or "Unknown Track"
artist = query("metadata/by-key/artist") or query("metadata/by-key/uploader") or ""
paused = query("pause")
pos = query("time-pos") or 0.0
dur = query("duration") or 0.0
vol = query("volume") or 100.0
speed = query("speed") or 1.0
loop_file = query("loop-file") or "no"
loop_pl = query("loop-playlist") or "no"

def fmt_time(sec):
    if not sec or sec < 0: return "00:00"
    m, s = divmod(int(sec), 60)
    h, m = divmod(m, 60)
    if h > 0: return f"{h:02d}:{m:02d}:{s:02d}"
    return f"{m:02d}:{s:02d}"

state_str = "⏸ Paused" if paused else "▶ Playing"
time_str = f"{fmt_time(pos)} / {fmt_time(dur)}"

bar = ""
if dur > 0:
    pct = min(1.0, max(0.0, pos / dur))
    w = 20
    filled = int(w * pct)
    b = "=" * filled + (">" if filled < w else "") + "-" * (w - filled - (1 if filled < w else 0))
    bar = f" [{b}] {int(pct*100)}%"

loop_str = "Track" if loop_file in ("inf", "yes") else ("Playlist" if loop_pl in ("inf", "yes") else "Off")

print("🎵 Tunes Status:")
print(f"  Track:    {title}")
if artist and artist not in title:
    print(f"  Artist:   {artist}")
print(f"  State:    {state_str}")
print(f"  Progress: {time_str}{bar}")
print(f"  Volume:   {int(vol)}%")
print(f"  Speed:    {speed:.2f}x")
print(f"  Loop:     {loop_str}")
PYEOF
}

cmd_notify() {
  if ! mpv_ipc '["get_property", "playback-time"]' 0 >/dev/null 2>&1; then
    desktop_notify "Tunes" "Not currently playing." "audio-headphones"
    echo "Tunes is not currently playing."
    return 0
  fi
  local title paused pos dur vol
  title=$(mpv_ipc '["get_property", "media-title"]' 1 || echo "Unknown Track")
  paused=$(mpv_ipc '["get_property", "pause"]' 1 || echo "false")
  vol=$(mpv_ipc '["get_property", "volume"]' 1 || echo "100")
  local state="Playing"
  [[ "$paused" == "true" ]] && state="Paused"
  desktop_notify "Now Playing ($state)" "$title (Vol: ${vol%.*}%)" "audio-headphones"
  echo "Notification sent: $title"
}

# Extended transport controls with desktop feedback
cmd_ctl() {
  local action="${1:-}" arg="${2:-}"
  case "$action" in
    pause|play-pause)
      if mpv_ipc '["cycle", "pause"]' 0; then
        local p
        p=$(mpv_ipc '["get_property", "pause"]' 1 || echo "")
        if [[ "$p" == "true" ]]; then
          echo "⏸ Paused"
          desktop_notify "Tunes" "Playback Paused" "media-playback-pause" -h "string:x-canonical-private-synchronous:tunes-state"
        else
          echo "▶ Resumed"
          desktop_notify "Tunes" "Playback Resumed" "media-playback-start" -h "string:x-canonical-private-synchronous:tunes-state"
        fi
      elif command -v playerctl >/dev/null 2>&1; then
        playerctl play-pause
      fi
      ;;
    play)
      mpv_ipc '["set_property", "pause", false]' 0 || { command -v playerctl >/dev/null 2>&1 && playerctl play; }
      desktop_notify "Tunes" "Playback Resumed" "media-playback-start" -h "string:x-canonical-private-synchronous:tunes-state"
      echo "▶ Resumed"
      ;;
    stop|quit)
      mpv_ipc '["quit"]' 0 || { command -v playerctl >/dev/null 2>&1 && playerctl stop; }
      rm -f "$MPV_SOCKET"
      desktop_notify "Tunes" "Playback Stopped" "media-playback-stop" -h "string:x-canonical-private-synchronous:tunes-state"
      echo "⏹ Stopped"
      ;;
    next)
      mpv_ipc '["playlist-next"]' 0 || { command -v playerctl >/dev/null 2>&1 && playerctl next; }
      echo "⏭ Skipped to next"
      ;;
    prev)
      mpv_ipc '["playlist-prev"]' 0 || { command -v playerctl >/dev/null 2>&1 && playerctl previous; }
      echo "⏮ Skipped to previous"
      ;;
    vol-up)
      local step="${arg:-5}"
      mpv_ipc "[\"add\", \"volume\", ${step}]" 0
      local vol
      vol=$(mpv_ipc '["get_property", "volume"]' 1 || echo "100")
      vol="${vol%.*}"
      desktop_notify "Volume" "${vol}%" "audio-volume-high" -h "string:x-canonical-private-synchronous:tunes-volume" -h "int:value:${vol}"
      echo "🔊 Volume: ${vol}%"
      ;;
    vol-down)
      local step="${arg:-5}"
      mpv_ipc "[\"add\", \"volume\", -${step}]" 0
      local vol
      vol=$(mpv_ipc '["get_property", "volume"]' 1 || echo "100")
      vol="${vol%.*}"
      desktop_notify "Volume" "${vol}%" "audio-volume-medium" -h "string:x-canonical-private-synchronous:tunes-volume" -h "int:value:${vol}"
      echo "🔉 Volume: ${vol}%"
      ;;
    vol)
      [[ -z "$arg" ]] && { echo "Usage: tunes ctl vol <0-100>"; exit 1; }
      mpv_ipc "[\"set_property\", \"volume\", ${arg}]" 0
      desktop_notify "Volume" "${arg}%" "audio-volume-high" -h "string:x-canonical-private-synchronous:tunes-volume" -h "int:value:${arg}"
      echo "🔊 Volume set to: ${arg}%"
      ;;
    mute)
      mpv_ipc '["cycle", "mute"]' 0
      local m
      m=$(mpv_ipc '["get_property", "mute"]' 1 || echo "")
      if [[ "$m" == "true" ]]; then
        desktop_notify "Volume" "Muted" "audio-volume-muted" -h "string:x-canonical-private-synchronous:tunes-volume"
        echo "🔇 Muted"
      else
        desktop_notify "Volume" "Unmuted" "audio-volume-high" -h "string:x-canonical-private-synchronous:tunes-volume"
        echo "🔊 Unmuted"
      fi
      ;;
    seek)
      local offset="${arg:-+10}"
      mpv_ipc "[\"seek\", ${offset}]" 0
      echo "⏩ Seeked ${offset}s"
      ;;
    speed)
      local sp="${arg:-1.0}"
      mpv_ipc "[\"set_property\", \"speed\", ${sp}]" 0
      desktop_notify "Speed" "${sp}x" "media-playback-start"
      echo "⚡ Playback speed: ${sp}x"
      ;;
    loop-on)
      mpv_ipc '["set_property", "loop-file", "inf"]' 0 && echo "🔁 Loop ON"
      desktop_notify "Tunes" "Loop Enabled" "media-playlist-repeat"
      ;;
    loop-off)
      mpv_ipc '["set_property", "loop-file", "no"]' 0 && echo "Loop OFF"
      desktop_notify "Tunes" "Loop Disabled" "media-playlist-repeat"
      ;;
    loop-toggle)
      mpv_ipc '["cycle-values", "loop-file", "inf", "no"]' 0
      local l
      l=$(mpv_ipc '["get_property", "loop-file"]' 1 || echo "")
      if [[ "$l" == "inf" ]]; then
        echo "🔁 Loop ON"
        desktop_notify "Tunes" "Loop Enabled" "media-playlist-repeat"
      else
        echo "Loop OFF"
        desktop_notify "Tunes" "Loop Disabled" "media-playlist-repeat"
      fi
      ;;
    status|info|np)
      cmd_status
      ;;
    *)
      cat <<EOF
Usage: tunes ctl {action} [args]

Actions:
  pause, play-pause     Toggle play/pause
  play                  Resume playback
  stop, quit            Stop playback and exit
  next                  Next track
  prev                  Previous track
  vol-up [step]         Increase volume (default: 5)
  vol-down [step]       Decrease volume (default: 5)
  vol <0-100>           Set volume level
  mute                  Toggle mute
  seek <+/-seconds>     Seek relative position (e.g. +15, -10)
  speed <rate>          Set playback speed (e.g. 1.25, 1.5)
  loop-toggle           Toggle looping on/off
  loop-on / loop-off    Turn looping on or off
  status                Show playback status
EOF
      exit 1
      ;;
  esac
}

# ---------- playlist management ----------

cmd_playlist() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list|"")
      echo "📂 Saved Playlists:"
      local count=0
      for pl in "$PLAYLISTS_DIR"/*.tsv; do
        [[ ! -f "$pl" ]] && continue
        local name; name=$(basename "$pl" .tsv)
        local tracks; tracks=$(wc -l < "$pl" | tr -d ' ')
        printf "  • %-20s (%d tracks)\n" "$name" "$tracks"
        count=$((count+1))
      done
      [[ $count -eq 0 ]] && echo "  (No playlists yet. Use: tunes playlist create <name>)"
      ;;
    create)
      local name="${1:-}"
      [[ -z "$name" ]] && read -rp "Playlist name: " name
      [[ -z "$name" ]] && exit 0
      local pl_file="$PLAYLISTS_DIR/${name}.tsv"
      touch "$pl_file"
      echo "✔ Playlist created: $name"
      ;;
    add)
      local name="${1:-}" query="${2:-}"
      [[ -z "$name" ]] && read -rp "Playlist name to add to: " name
      [[ -z "$name" ]] && exit 0
      local pl_file="$PLAYLISTS_DIR/${name}.tsv"
      [[ ! -f "$pl_file" ]] && touch "$pl_file"
      local selection
      if [[ -n "$query" ]]; then
        selection=$(search_and_pick "$query" | pick_from_list "Add to $name > ") || exit 0
      else
        selection=$(pick_from_list "Add from history > " < "$HISTORY_FILE") || exit 0
      fi
      [[ -z "$selection" ]] && exit 0
      local title url
      title=$(cut -f1 <<<"$selection")
      url=$(cut -f2 <<<"$selection")
      dedupe_tsv_by_url "$pl_file" "$url"
      echo -e "${title}\t${url}" >> "$pl_file"
      echo "✔ Added '$title' to playlist '$name'"
      desktop_notify "Playlist Updated" "Added to $name: $title" "audio-x-generic"
      ;;
    play)
      local name="${1:-}"
      [[ -z "$name" ]] && read -rp "Playlist name to play: " name
      [[ -z "$name" ]] && exit 0
      local pl_file="$PLAYLISTS_DIR/${name}.tsv"
      [[ ! -s "$pl_file" ]] && { echo "Playlist '$name' not found or empty."; exit 1; }

      local m3u_file; m3u_file=$(mktemp /tmp/tunes-pl-XXXX.m3u)
      local count=0
      while IFS=$'\t' read -r title url; do
        [[ -z "$url" ]] && continue
        local clean; clean=$(clean_title "$title")
        log_history "$title" "$url"
        { echo "#EXTINF:-1,${clean}"; echo "$url"; } >> "$m3u_file"
        count=$((count+1))
      done < "$pl_file"

      cleanup_stale_socket
      local loop_flag="" shuffle_flag=""
      [[ "${LOOP:-0}" == "1" ]] && loop_flag="--loop-playlist=inf"
      [[ "${SHUFFLE:-0}" == "1" ]] && shuffle_flag="--shuffle"
      local script_args; script_args=$(get_mpv_script_args)

      if [[ "${DETACH:-0}" == "1" ]]; then
        echo "▶ Playing playlist '$name' (${count} tracks) in background"
        nohup mpv --no-video --input-ipc-server="$MPV_SOCKET" \
            $script_args $YTDL_ARGS $loop_flag $shuffle_flag "$m3u_file" > "$DATA_DIR/tunes.log" 2>&1 &
        local pid=$!
        disown "$pid"
        desktop_notify "Playlist: $name" "Playing ${count} tracks in background" "audio-headphones"
      else
        echo "▶ Playing playlist '$name' (${count} tracks)"
        mpv --no-video --input-ipc-server="$MPV_SOCKET" \
            $script_args $YTDL_ARGS $loop_flag $shuffle_flag --term-osd-bar "$m3u_file"
        rm -f "$m3u_file"
      fi
      ;;
    view)
      local name="${1:-}"
      [[ -z "$name" ]] && read -rp "Playlist name: " name
      [[ -z "$name" ]] && exit 0
      local pl_file="$PLAYLISTS_DIR/${name}.tsv"
      [[ ! -s "$pl_file" ]] && { echo "Playlist '$name' is empty or does not exist."; exit 1; }
      echo "Tracks in '$name':"
      nl -ba -w2 -s'. ' <(cut -f1 "$pl_file")
      ;;
    delete)
      local name="${1:-}"
      [[ -z "$name" ]] && read -rp "Playlist name to delete: " name
      [[ -z "$name" ]] && exit 0
      local pl_file="$PLAYLISTS_DIR/${name}.tsv"
      if [[ -f "$pl_file" ]]; then
        rm -f "$pl_file"
        echo "✔ Deleted playlist: $name"
      else
        echo "Playlist '$name' not found."
      fi
      ;;
    *)
      echo "Usage: tunes playlist {list|create|add|play|view|delete} [name]"; exit 1 ;;
  esac
}

# ---------- podcast commands ----------

play_podcast_url() {
  local title="$1" url="$2" feed_name="${3:-}" loop_flag=""
  dedupe_tsv_by_url "$POD_HISTORY_FILE" "$url"
  { echo -e "${title}\t${url}\t${feed_name}"; cat "$POD_HISTORY_FILE" 2>/dev/null; } > "$POD_HISTORY_FILE.tmp"
  mv "$POD_HISTORY_FILE.tmp" "$POD_HISTORY_FILE"
  head -n 300 "$POD_HISTORY_FILE" > "$POD_HISTORY_FILE.tmp" && mv "$POD_HISTORY_FILE.tmp" "$POD_HISTORY_FILE"
  cleanup_stale_socket

  [[ "${LOOP:-0}" == "1" ]] && loop_flag="--loop-file=inf"
  local script_args; script_args=$(get_mpv_script_args)

  if [[ "${DETACH:-0}" == "1" ]]; then
    echo "🎙 Playing in background: $title"
    nohup mpv --no-video --input-ipc-server="$MPV_SOCKET" \
        $script_args \
        --force-media-title="$title" \
        --save-position-on-quit \
        $loop_flag \
        "$url" > "$DATA_DIR/tunes.log" 2>&1 &
    local pid=$!
    disown "$pid"
    desktop_notify "Podcast (Background)" "$title" "audio-headphones"
    echo "  (Process PID: $pid. Use 'tunes status' or 'tunes ctl' to control)"
  else
    echo "🎙 Playing: $title"
    mpv --no-video --input-ipc-server="$MPV_SOCKET" \
        $script_args \
        --force-media-title="$title" \
        --save-position-on-quit \
        $loop_flag --term-osd-bar \
        "$url"
  fi
}

