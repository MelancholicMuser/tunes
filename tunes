llm_models() {
  local base; base=$(llm_base)
  local args=(-sf --max-time 5)
  [[ -n "$LLM_API_KEY" ]] && args+=(-H "Authorization: Bearer $LLM_API_KEY")
  if [[ "$LLM_BACKEND" == openai ]]; then
    curl "${args[@]}" "$base/v1/models" 2>/dev/null \
      | python3 -c 'import sys,json; [print(m.get("id","")) for m in json.load(sys.stdin).get("data",[])]' 2>/dev/null || true
  else
    curl "${args[@]}" "$base/api/tags" 2>/dev/null \
      | python3 -c 'import sys,json; [print(m.get("name","")) for m in json.load(sys.stdin).get("models",[])]' 2>/dev/null || true
  fi
}

ai_test() {
  echo "Backend: $LLM_BACKEND   URL: $LLM_URL   Model: $LLM_MODEL"
  if ! llm_available; then
    echo "✗ Server not reachable."
    echo "  Start it (Ollama: 'ollama serve'), or point tunes at it:  tunes ai setup"
    return 1
  fi
  echo "✓ Server reachable"
  local models; models=$(llm_models)
  if [[ -n "$models" ]]; then
    if grep -qxF "$LLM_MODEL" <<<"$models"; then
      echo "✓ Model '$LLM_MODEL' is available"
    else
      echo "✗ Model '$LLM_MODEL' not found. Available: $(tr '\n' ' ' <<<"$models")"
      [[ "$LLM_BACKEND" == ollama ]] && echo "  Install it with: ollama pull $LLM_MODEL"
      echo "  Or choose another:  tunes config set LLM_MODEL <name>"
      return 1
    fi
  fi
  echo "… sending a tiny test prompt"
  local t0 t1 out
  t0=$(date +%s)
  if out=$(llm_ask "You are a connectivity test." "Reply with the single word: ok"); then
    t1=$(date +%s)
    echo "✓ Model replied in $((t1 - t0))s: ${out:0:60}"
  else
    echo "✗ The model did not answer (see message above)."; return 1
  fi
}

ai_setup() {
  echo "Connect a local LLM (used for: report --ai, ask, mood, recommend)"
  echo "  1) ollama   — Ollama, default http://localhost:11434"
  echo "  2) openai   — any OpenAI-compatible server (llama.cpp, LM Studio, vLLM, …)"
  local choice backend url model key
  read -rp "Backend [1/2] (current: $LLM_BACKEND): " choice
  case "$choice" in
    1|ollama) backend=ollama ;;
    2|openai) backend=openai ;;
    "") backend="$LLM_BACKEND" ;;
    *) echo "Please answer 1 or 2."; return 1 ;;
  esac
  local default_url="http://localhost:11434"
  [[ "$backend" == openai ]] && default_url="http://localhost:8080"
  [[ "$backend" == "$LLM_BACKEND" ]] && default_url="$LLM_URL"
  read -rp "Server URL [$default_url]: " url; url="${url:-$default_url}"
  config_set LLM_BACKEND "$backend"; config_set LLM_URL "$url"
  LLM_BACKEND="$backend"; LLM_URL="$url"
  if [[ "$backend" == openai ]]; then
    read -rp "API key (leave empty if none): " key
    [[ -n "$key" ]] && config_set LLM_API_KEY "$key" && LLM_API_KEY="$key"
  fi
  if llm_available; then
    local models; models=$(llm_models)
    [[ -n "$models" ]] && { echo "Models on this server:"; sed 's/^/  • /' <<<"$models"; }
  fi
  read -rp "Model name [$LLM_MODEL]: " model; model="${model:-$LLM_MODEL}"
  config_set LLM_MODEL "$model"; LLM_MODEL="$model"
  echo; ai_test || true
}

cmd_ai() {
  require python3 curl
  case "${1:-test}" in
    test) ai_test ;;
    setup|connect) ai_setup ;;
    models) llm_available && llm_models || { echo "Server not reachable at $LLM_URL"; return 1; } ;;
    *) echo "Usage: tunes ai {test|setup|models}"; return 1 ;;
  esac
}

config_set() {
  local key="$1" val="$2"
  if ! is_config_key "$key"; then
    echo "Unknown setting '$key'. Valid settings: ${CONFIG_KEYS[*]}" >&2; return 1
  fi
  case "$key" in
    LLM_BACKEND) [[ "$val" =~ ^(ollama|openai)$ ]] || { echo "LLM_BACKEND must be 'ollama' or 'openai' (any OpenAI-compatible server)" >&2; return 1; } ;;
    LLM_TIMEOUT|PLAY_THRESHOLD) [[ "$val" =~ ^[0-9]+$ ]] && ((10#$val > 0)) || { echo "$key must be a positive whole number" >&2; return 1; } ;;
    DEFAULT_VOLUME) [[ -z "$val" || "$val" =~ ^[0-9]+$ ]] || { echo "DEFAULT_VOLUME must be a number (e.g. 70) or empty" >&2; return 1; } ;;
    REPORT_REMINDER) [[ "$val" =~ ^(on|off)$ ]] || { echo "REPORT_REMINDER must be 'on' or 'off'" >&2; return 1; } ;;
    AUTOPLAY) [[ "$val" =~ ^(on|off)$ ]] || { echo "AUTOPLAY must be 'on' or 'off'" >&2; return 1; }
      # Write to state file immediately so live mpv sessions pick it up
      set_autoplay_state "$val" ;;
    AUDIO_QUALITY) [[ "$val" =~ ^(highest|high|standard)$ ]] || { echo "AUDIO_QUALITY must be 'highest', 'high', or 'standard'" >&2; return 1; } ;;
    AUDIO_ENHANCE) [[ "$val" =~ ^(on|off)$ ]] || { echo "AUDIO_ENHANCE must be 'on' or 'off'" >&2; return 1; }
      AUDIO_ENHANCE="$val"
      if mpv_ipc '["get_property","pid"]' 0 >/dev/null 2>&1; then
        local f; f=$(get_audio_filter_string "$val" "$AUDIO_PRESET")
        mpv_ipc "[\"set_property_string\", \"af\", \"$f\"]" 0 >/dev/null 2>&1 || true
      fi ;;
    AUDIO_PRESET) [[ "$val" =~ ^(crystalizer|clarity|vocal|warm|bass|norm|r128|spatial|widen|studio|flat|custom)$ ]] || { echo "AUDIO_PRESET must be 'crystalizer', 'clarity', 'warm', 'bass', 'norm', 'spatial', 'studio' or 'custom'" >&2; return 1; }
      AUDIO_PRESET="$val"
      if mpv_ipc '["get_property","pid"]' 0 >/dev/null 2>&1; then
        local f; f=$(get_audio_filter_string "$AUDIO_ENHANCE" "$val")
        mpv_ipc "[\"set_property_string\", \"af\", \"$f\"]" 0 >/dev/null 2>&1 || true
      fi ;;
    AUDIO_CUSTOM_AF) [[ "$val" != *\"* && "$val" != *\\* ]] || { echo "AUDIO_CUSTOM_AF must not contain quotes or backslashes (example: equalizer=f=100:t=q:w=1:g=3)" >&2; return 1; } ;;
    REPLAYGAIN) [[ "$val" =~ ^(off|track|album)$ ]] || { echo "REPLAYGAIN must be 'off', 'track' or 'album'" >&2; return 1; } ;;
    LISTENBRAINZ_URL) [[ "$val" =~ ^https?:// ]] || { echo "LISTENBRAINZ_URL must start with http:// or https://" >&2; return 1; } ;;
    DOWNLOAD_FORMAT) [[ "$val" =~ ^(best|flac|opus|mp3|m4a|wav)$ ]] || { echo "DOWNLOAD_FORMAT must be 'best', 'flac', 'opus', 'mp3', 'm4a', or 'wav'" >&2; return 1; } ;;
  esac
  mkdir -p "$(dirname "$CONFIG_FILE")"
  touch "$CONFIG_FILE"; chmod 600 "$CONFIG_FILE" 2>/dev/null || true
  { grep -v -E "^[[:space:]]*${key}=" "$CONFIG_FILE" 2>/dev/null || true; printf '%s=%s\n' "$key" "$val"; } > "$CONFIG_FILE.tmp"
  mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"; chmod 600 "$CONFIG_FILE" 2>/dev/null || true
}

config_unset() {
  is_config_key "$1" || { echo "Unknown setting '$1'" >&2; return 1; }
  [[ -f "$CONFIG_FILE" ]] || return 0
  { grep -v -E "^[[:space:]]*${1}=" "$CONFIG_FILE" 2>/dev/null || true; } > "$CONFIG_FILE.tmp"
  mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
}

cmd_config() {
  local sub="${1:-show}"; shift || true
  case "$sub" in
    show|"")
      echo "Config file: $CONFIG_FILE$([[ -f "$CONFIG_FILE" ]] || echo '  (not created yet — defaults in use)')"
      local k v o note
      for k in "${CONFIG_KEYS[@]}"; do
        v="${!k:-}"; note=""
        [[ ( "$k" == LLM_API_KEY || "$k" == LISTENBRAINZ_TOKEN ) && -n "$v" ]] && v="********"
        for o in "${ENV_OVERRIDES[@]:-}"; do
          [[ "$o" == "$k" ]] && note="   (overridden by environment variable)"
        done
        printf '  %-16s %s%s\n' "$k" "${v:-<empty>}" "$note"
      done
      echo
      echo "Change with:  tunes config set KEY VALUE     (LLM wizard: tunes ai setup)"
      ;;
    path) echo "$CONFIG_FILE" ;;
    set)
      [[ $# -ge 1 ]] || { echo "Usage: tunes config set KEY VALUE" >&2; return 1; }
      config_set "$1" "${2:-}" && echo "✔ $1 saved" ;;
    unset) config_unset "${1:-}" && echo "✔ ${1:-} reset to default" ;;
    edit)
      mkdir -p "$(dirname "$CONFIG_FILE")"; touch "$CONFIG_FILE"
      "${EDITOR:-${VISUAL:-vi}}" "$CONFIG_FILE" ;;
    *) echo "Usage: tunes config {show|set KEY VALUE|unset KEY|edit|path}" >&2; return 1 ;;
  esac
}

install_hint() {
  if command -v apt >/dev/null 2>&1; then echo "sudo apt install $*"
  elif command -v dnf >/dev/null 2>&1; then echo "sudo dnf install $*"
  elif command -v pacman >/dev/null 2>&1; then echo "sudo pacman -S $*"
  elif command -v brew >/dev/null 2>&1; then echo "brew install $*"
  else echo "install: $*"; fi
}

cmd_doctor() {
  echo "tunes $TUNES_VERSION — environment check"
  echo
  local d bad=0
  echo "Required:"
  for d in mpv yt-dlp fzf python3 curl jq; do
    if command -v "$d" >/dev/null 2>&1; then printf '  ✓ %s\n' "$d"
    else printf '  ✗ %-8s → %s\n' "$d" "$(install_hint "$d")"; bad=1; fi
  done
  echo "Optional:"
  local pair
  for pair in "ffmpeg:mp3 downloads" "notify-send:desktop notifications (libnotify)" "playerctl:media keys" \
              "sptlrx:synced lyrics" "vlc:'tunes vlc'" "shuf:personal mix (falls back to sort -R)"; do
    d="${pair%%:*}"
    if command -v "$d" >/dev/null 2>&1; then printf '  ✓ %-12s %s\n' "$d" "${pair#*:}"
    else printf '  · %-12s %s (not installed)\n' "$d" "${pair#*:}"; fi
  done
  echo "Local LLM:"
  if command -v curl >/dev/null 2>&1 && llm_available; then
    printf '  ✓ %s at %s (model: %s)\n' "$LLM_BACKEND" "$LLM_URL" "$LLM_MODEL"
  else
    printf '  · not reachable (%s at %s) — optional; set up with: tunes ai setup\n' "$LLM_BACKEND" "$LLM_URL"
  fi
  echo "Data:"
  printf '  %s\n' "$DATA_DIR"
  if [[ -f "$PLAYS_FILE" ]]; then
    printf '  ✓ play log: %s sessions recorded\n' "$(grep -c . "$PLAYS_FILE" 2>/dev/null || echo 0)"
  else
    echo "  · play log: nothing recorded yet (it starts with your next play)"
  fi
  echo "High Fidelity Audio:"
  printf '  ✓ stream quality:   %s (Opus 48kHz preferred)\n' "${AUDIO_QUALITY:-highest}"
  printf '  ✓ audio enhance:    %s (preset: %s)\n' "${AUDIO_ENHANCE:-off}" "${AUDIO_PRESET:-crystalizer}"
  printf '  ✓ mpv resampling:   32-point filter, gapless\n'
  if command -v ffmpeg >/dev/null 2>&1; then
    printf '  ✓ audio DSP:        ffmpeg filters available (crystalizer, limiter, loudnorm)\n'
  fi
  if command -v node >/dev/null 2>&1; then
    printf '  ✓ js runtime:       Node.js (/usr/bin/node) active for yt-dlp\n'
  fi
  return $bad
}

