#!/usr/bin/env bash
# tunes — a lightweight terminal music & podcast player
#   Stream (yt-dlp + mpv), queue, playlists, favorites, podcasts, per-song play
#   counts, listening reports, and optional local-LLM insights
#   (Ollama or any OpenAI-compatible server such as llama.cpp / LM Studio).
# Deps: mpv, yt-dlp, fzf, python3, curl, jq   (stats / report / config / help only need python3)
# Optional: playerctl, sptlrx, notify-send, a local LLM server

set -euo pipefail

TUNES_VERSION="2.2.0"
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"

# ---------- paths ----------

DATA_DIR="${TUNES_DATA_DIR:-$HOME/.local/share/tunes}"
PLAYLISTS_DIR="$DATA_DIR/playlists"
SCRIPTS_DIR="$DATA_DIR/scripts"
REPORTS_DIR="$DATA_DIR/reports"
HISTORY_FILE="$DATA_DIR/history.tsv"          # title\turl            (recent, de-duplicated)
FAVORITES_FILE="$DATA_DIR/favorites.tsv"      # title\turl
FEEDS_FILE="$DATA_DIR/feeds.tsv"              # name\turl
POD_HISTORY_FILE="$DATA_DIR/podcast_history.tsv"  # title\turl\tfeed_name
PLAYS_FILE="$DATA_DIR/plays.tsv"              # epoch\tkind\tlistened\tduration\ttitle\tartist\turl
QUEUE_FILE="$DATA_DIR/current-queue.m3u"
LOG_FILE="$DATA_DIR/tunes.log"
LAST_REPORT_FILE="$DATA_DIR/.last_report"
AUTOPLAY_STATE_FILE="$DATA_DIR/.autoplay_state"
DOWNLOAD_DIR="${TUNES_DOWNLOAD_DIR:-$HOME/Music/tunes-downloads}"
POD_DOWNLOAD_DIR="$DOWNLOAD_DIR/Podcasts"

RUNTIME_BASE="${XDG_RUNTIME_DIR:-/tmp}"
MPV_SOCKET="${RUNTIME_BASE}/tunes-mpv-${UID:-$(id -u)}.sock"

# ---------- configuration ----------
# Settings live in a plain KEY=VALUE file (never executed). Real environment
# variables always override it. Manage with:  tunes config

CONFIG_FILE="${TUNES_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/tunes/config}"
CONFIG_KEYS=(LLM_BACKEND LLM_URL LLM_MODEL LLM_API_KEY LLM_TIMEOUT YT_CLIENT PLAY_THRESHOLD REPORT_REMINDER DEFAULT_VOLUME AUTOPLAY AUDIO_QUALITY AUDIO_ENHANCE AUDIO_PRESET AUDIO_CUSTOM_AF REPLAYGAIN DOWNLOAD_FORMAT MUSIC_DIR LISTENBRAINZ_TOKEN LISTENBRAINZ_URL)

is_config_key() {
  local k
  for k in "${CONFIG_KEYS[@]}"; do [[ "$k" == "$1" ]] && return 0; done
  return 1
}

ENV_OVERRIDES=()
load_config() {
  [[ -f "$CONFIG_FILE" ]] || return 0
  local line key val
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ "$line" =~ ^[[:space:]]*([A-Z_]+)=(.*)$ ]] || continue
    key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"
    is_config_key "$key" || continue
    if [[ -n "${!key+x}" ]]; then ENV_OVERRIDES+=("$key"); continue; fi   # environment wins over the file
    val="${val%\"}"; val="${val#\"}"; val="${val%\'}"; val="${val#\'}"
    printf -v "$key" '%s' "$val"
  done < "$CONFIG_FILE"
}
load_config

case "${LLM_BACKEND:-ollama}" in
  openai|llamacpp|llama.cpp|lmstudio|vllm|oai) LLM_BACKEND=openai ;;
  *) LLM_BACKEND=ollama ;;
esac
if [[ -z "${LLM_URL:-}" ]]; then
  if [[ -n "${OLLAMA_URL:-}" ]]; then LLM_URL="$OLLAMA_URL"            # legacy variable
  elif [[ "$LLM_BACKEND" == openai ]]; then LLM_URL="http://localhost:8080"
  else LLM_URL="http://localhost:11434"; fi
fi
LLM_MODEL="${LLM_MODEL:-${OLLAMA_MODEL:-llama3.2:3b}}"           # OLLAMA_MODEL = legacy variable
LLM_API_KEY="${LLM_API_KEY:-}"
LLM_TIMEOUT="${LLM_TIMEOUT:-120}"
YT_CLIENT="${YT_CLIENT-}"               # default empty to allow yt-dlp to negotiate the best modern client (e.g. 48kHz Opus)
PLAY_THRESHOLD="${PLAY_THRESHOLD:-30}"  # seconds of listening that count as one "play"
REPORT_REMINDER="${REPORT_REMINDER:-on}"
DEFAULT_VOLUME="${DEFAULT_VOLUME:-}"
AUTOPLAY="${AUTOPLAY:-on}"
AUDIO_QUALITY="${AUDIO_QUALITY:-highest}"       # highest (48kHz Opus), high, standard
AUDIO_ENHANCE="${AUDIO_ENHANCE:-off}"           # on/off: optional DSP (opt-in; "studio" = untouched audio)
AUDIO_PRESET="${AUDIO_PRESET:-crystalizer}"     # crystalizer, clarity, warm, bass, norm, spatial, studio, custom
DOWNLOAD_FORMAT="${DOWNLOAD_FORMAT:-best}"      # best (native bitstream, zero loss), flac, opus, mp3
AUDIO_CUSTOM_AF="${AUDIO_CUSTOM_AF:-}"          # your own mpv/ffmpeg filter chain, used when AUDIO_PRESET=custom
REPLAYGAIN="${REPLAYGAIN:-off}"                 # off | track | album (reads ReplayGain tags in local files & downloads)
MUSIC_DIR="${MUSIC_DIR:-$HOME/Music}"           # folder used by: tunes local
LISTENBRAINZ_TOKEN="${LISTENBRAINZ_TOKEN:-}"    # user token from https://listenbrainz.org/settings/ (tunes scrobble)
LISTENBRAINZ_URL="${LISTENBRAINZ_URL:-https://api.listenbrainz.org}"

get_audio_filter_string() {
  local enhance="${1:-${AUDIO_ENHANCE:-off}}"
  local preset="${2:-${AUDIO_PRESET:-crystalizer}}"
  [[ "$enhance" != "on" ]] && { echo ""; return 0; }
  # crystalizer exaggerates dynamics and can push peaks past 0 dBFS, so those presets end in a limiter.
  local lim="alimiter=limit=0.97"
  case "$preset" in
    crystalizer)     echo "crystalizer=i=2:c=1,$lim" ;;
    clarity|vocal)   echo "crystalizer=i=2.5:c=1,equalizer=f=3200:t=q:w=1.2:g=2,$lim" ;;
    warm)            echo "crystalizer=i=1.5:c=1,bass=g=3:f=110:w=0.6,$lim" ;;
    bass)            echo "crystalizer=i=1.5:c=1,bass=g=4.5:f=90:w=0.5,$lim" ;;
    norm|r128)       echo "loudnorm=I=-16:TP=-1.5:LRA=11" ;;
    spatial|widen)   echo "crystalizer=i=1.8:c=1,extrastereo=m=1.15,$lim" ;;
    custom)          echo "${AUDIO_CUSTOM_AF:-}" ;;
    studio|flat|off) echo "" ;;
    *)               echo "crystalizer=i=2:c=1,$lim" ;;
  esac
}

get_autoplay_state() {
  if [[ -f "$AUTOPLAY_STATE_FILE" ]]; then
    local s; s=$(tr -d ' \r\n' < "$AUTOPLAY_STATE_FILE" 2>/dev/null || true)
    if [[ -n "$s" ]]; then printf '%s' "$s"; return 0; fi
  fi
  printf '%s' "${AUTOPLAY:-on}"
}

set_autoplay_state() {
  mkdir -p "$DATA_DIR"
  printf '%s\n' "$1" > "$AUTOPLAY_STATE_FILE"
}

# ---------- small helpers ----------

require() {
  local missing=() d
  for d in "$@"; do command -v "$d" >/dev/null 2>&1 || missing+=("$d"); done
  if ((${#missing[@]})); then
    echo "Missing dependency: ${missing[*]}" >&2
    echo "Run 'tunes doctor' for install hints." >&2
    exit 1
  fi
}

# Create state files lazily (only commands that need them call this).
init_state() {
  mkdir -p "$DATA_DIR" "$PLAYLISTS_DIR" "$SCRIPTS_DIR"
  touch "$HISTORY_FILE" "$FAVORITES_FILE" "$FEEDS_FILE" "$POD_HISTORY_FILE" "$PLAYS_FILE"
}

# TSV fields must not contain tabs/newlines.
sanitize_field() {
  local s="$1"
  s="${s//$'\t'/ }"; s="${s//$'\n'/ }"; s="${s//$'\r'/ }"
  printf '%s' "$s"
}

# Playlist names become file names: keep them safe.
sanitize_name() {
  local s; s=$(sanitize_field "$1")
  s="${s//\//-}"; s="${s//\\/-}"
  s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"
  while [[ "$s" == .* ]]; do s="${s#.}"; done
  printf '%s' "$s"
}

# ---------- GNOME / desktop integration ----------

# Ensure GNOME desktop file and MPRIS/notify scripts are installed
ensure_integration() {
  [[ -n "${_TUNES_INTEGRATED:-}" ]] && return 0
  _TUNES_INTEGRATED=1
  local apps_dir="$HOME/.local/share/applications"
  local desktop_file="$apps_dir/tunes.desktop"
  if [[ ! -f "$desktop_file" ]]; then
    mkdir -p "$apps_dir"
    cat <<'EOF' > "$desktop_file"
[Desktop Entry]
Name=Tunes
GenericName=Terminal Music Player
Comment=Terminal music and podcast player with GNOME controls
Exec=tunes
Icon=audio-headphones
Terminal=true
Type=Application
Categories=AudioVideo;Audio;Player;
Keywords=music;podcast;audio;player;mpv;yt-dlp;
StartupNotify=false
EOF
    if command -v update-desktop-database >/dev/null 2>&1; then
      update-desktop-database "$apps_dir" 2>/dev/null || true
    fi
  fi

  # Ensure mpv lua notification script exists
  local notify_script="$SCRIPTS_DIR/tunes-notify.lua"
  if [[ ! -f "$notify_script" ]]; then
    cat <<'EOF' > "$notify_script"
local mp = require 'mp'

local function notify_track()
    local title = mp.get_property("media-title")
    if not title or title == "" or title == "mpv" then return end

    local artist = mp.get_property("metadata/by-key/artist") or ""
    local uploader = mp.get_property("metadata/by-key/uploader") or ""
    if artist == "" and uploader ~= "" then
        artist = uploader
    end

    local pos = mp.get_property_number("playlist-pos-1", 1)
    local total = mp.get_property_number("playlist-count", 1)

    local header = "Now Playing"
    if total and total > 1 then
        header = string.format("Now Playing (%d/%d)", pos, total)
    end

    local body = title
    if artist ~= "" and not string.find(title, artist, 1, true) then
        body = artist .. " — " .. title
    end

    mp.command_native_async({
        name = "subprocess",
        playback_only = false,
        capture_stdout = true,
        args = {
            "notify-send",
            "-a", "Tunes",
            "-i", "audio-headphones",
            "-h", "string:desktop-entry:tunes",
            "-t", "5000",
            "-A", "pause=⏯ Play/Pause",
            "-A", "next=⏭ Next",
            header,
            body
        }
    }, function(success, res, err)
        if success and res and res.stdout then
            local action = res.stdout:gsub("%s+", "")
            if action == "pause" then
                mp.commandv("cycle", "pause")
            elseif action == "next" then
                mp.commandv("playlist-next")
            end
        end
    end)
end

mp.register_event("file-loaded", notify_track)
EOF
  fi

  # Auto-load mpris.so into mpv user config if available
  local mpv_scripts_dir="$HOME/.config/mpv/scripts"
  if [[ -f "$SCRIPTS_DIR/mpris.so" && ! -f "$mpv_scripts_dir/mpris.so" ]]; then
    mkdir -p "$mpv_scripts_dir"
    cp "$SCRIPTS_DIR/mpris.so" "$mpv_scripts_dir/mpris.so" 2>/dev/null || true
  fi
  return 0
}

# Writes the play-tracking mpv script (re-written whenever its version stamp is missing).
ensure_tracker() {
  local f="$SCRIPTS_DIR/tunes-track.lua"
  grep -q 'tunes-lua v1' "$f" 2>/dev/null && return 0
  mkdir -p "$SCRIPTS_DIR"
  cat > "$f" <<'LUAEOF'
-- tunes-lua v1: play tracker. Appends one line per listening session to the
-- plays log: epoch \t kind \t seconds_listened \t duration \t title \t artist \t url
local mp = require 'mp'

local plays_file = os.getenv("TUNES_PLAYS_FILE")
if not plays_file or plays_file == "" then return end
local kind = os.getenv("TUNES_KIND") or "music"

local MIN_LOG = 3      -- ignore sessions shorter than this many seconds
local cur = nil        -- state of the track currently being listened to

local function clean(s)
    return (tostring(s or ""):gsub("[%c]+", " "))
end

local function artist_from(meta)
    if type(meta) ~= "table" then return "" end
    local lower = {}
    for k, v in pairs(meta) do lower[tostring(k):lower()] = v end
    return lower["artist"] or lower["uploader"] or lower["channel"]
        or lower["album_artist"] or ""
end

local function start_track()
    cur = {
        url = mp.get_property("path") or "",
        title = mp.get_property("media-title") or "",
        artist = artist_from(mp.get_property_native("metadata")),
        duration = mp.get_property_number("duration") or 0,
        listened = 0,
        last_pos = nil,
        started = os.time(),
    }
end

local function flush()
    if not cur then return end
    local c = cur
    cur = nil
    if c.url == "" or c.listened < MIN_LOG then return end
    local f = io.open(plays_file, "a")
    if not f then return end
    f:write(string.format("%d\t%s\t%.1f\t%.1f\t%s\t%s\t%s\n",
        c.started, clean(kind), c.listened, c.duration,
        clean(c.title), clean(c.artist), clean(c.url)))
    f:close()
end

-- Keep metadata fresh: streams often fill these in after file-loaded.
mp.observe_property("media-title", "string", function(_, v)
    if cur and v and v ~= "" then cur.title = v end
end)
mp.observe_property("duration", "number", function(_, v)
    if cur and v and v > 0 then cur.duration = v end
end)
mp.observe_property("metadata", "native", function(_, v)
    if cur then
        local a = artist_from(v)
        if a ~= "" then cur.artist = a end
    end
end)

-- Accumulate *actually played* media seconds: small forward steps only, so
-- seeks don't inflate the total and pauses add nothing.
mp.observe_property("time-pos", "number", function(_, pos)
    if not cur or not pos then return end
    local last = cur.last_pos
    if last then
        local d = pos - last
        if d > 0 and d < 5 then
            cur.listened = cur.listened + d
        elseif d < -5 and last > 0 and cur.duration > 0
               and last >= cur.duration - 5 and pos < 5 then
            -- natural loop-around (--loop-file): close this play, begin the next
            flush()
            start_track()
        end
    end
    if cur then cur.last_pos = pos end
end)

mp.register_event("file-loaded", function() flush(); start_track() end)
mp.register_event("end-file", flush)
mp.register_event("shutdown", flush)
LUAEOF
}

# Writes the autoplay / Up Next mpv script (re-written whenever version stamp is missing)
ensure_autoplay() {
  local f="$SCRIPTS_DIR/tunes-autoplay.lua"
  grep -q 'tunes-lua-autoplay v1' "$f" 2>/dev/null && return 0
  mkdir -p "$SCRIPTS_DIR"
  cat > "$f" <<'LUAEOF'
-- tunes-lua-autoplay v1: Spotify-style Autoplay & Up Next
local mp = require 'mp'

local tunes_bin = os.getenv("TUNES_BIN") or "tunes"
local data_dir = os.getenv("TUNES_DATA_DIR") or (os.getenv("HOME") .. "/.local/share/tunes")
local autoplay_file = os.getenv("TUNES_AUTOPLAY_FILE") or (data_dir .. "/.autoplay_state")
local default_autoplay = os.getenv("TUNES_AUTOPLAY") or "on"
local kind = os.getenv("TUNES_KIND") or "music"

local fetching = false
local last_fetched_url = ""

local function is_enabled()
    if kind ~= "music" then return false end
    local f = io.open(autoplay_file, "r")
    if f then
        local s = f:read("*all")
        f:close()
        s = s:gsub("%s+", ""):lower()
        if s == "off" or s == "0" or s == "false" then return false end
        if s == "on" or s == "1" or s == "true" then return true end
    end
    return default_autoplay == "on" or default_autoplay == "1" or default_autoplay == "true"
end

local function is_looping()
    local lf = mp.get_property("loop-file") or "no"
    local lp = mp.get_property("loop-playlist") or "no"
    return lf == "inf" or lf == "yes" or lp == "inf" or lp == "yes"
end

local function is_streaming(url)
    return tostring(url or ""):match("^https?://") ~= nil
end

local function check_and_replenish()
    if not is_enabled() then return end
    if is_looping() then return end
    if fetching then return end

    local cur_url = mp.get_property("path") or ""
    if cur_url == "" or not is_streaming(cur_url) or cur_url == last_fetched_url then return end

    local count = mp.get_property_number("playlist-count", 0)
    local pos = mp.get_property_number("playlist-pos-1", 0)
    local remaining = count - pos

    if remaining > 1 then return end

    local cur_title = mp.get_property("media-title") or ""

    fetching = true
    last_fetched_url = cur_url

    mp.command_native_async({
        name = "subprocess",
        playback_only = false,
        capture_stdout = true,
        args = { tunes_bin, "__upnext_fetch", cur_url, cur_title }
    }, function(success, res, err)
        fetching = false
        if success and res and res.stdout and res.stdout ~= "" then
            local m3u_path = res.stdout:gsub("[\r\n]+", "")
            if m3u_path ~= "" then
                mp.commandv("loadlist", m3u_path, "append")
            end
        end
    end)
end

mp.register_event("file-loaded", function()
    check_and_replenish()
end)

mp.observe_property("loop-file", "string", function(_, val)
    if val ~= "inf" and val ~= "yes" then
        check_and_replenish()
    end
end)
LUAEOF
}

# ---------- mpv IPC ----------
# mpv_ipc '<json command array>' [mode]
#   mode 0: fire & check (default)   1: print the scalar result   2: print JSON result
# Replies are matched by request_id, so asynchronous mpv events can't be mistaken for them.
IPC_PY=''
read -r -d '' IPC_PY <<'PYEOF' || true
import sys, socket, json
path, raw, mode = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    cmd = json.loads(raw)
except Exception:
    sys.exit(1)
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(1.5)
    s.connect(path)
    s.sendall((json.dumps({"command": cmd, "request_id": 4242}) + "\n").encode())
    buf = b""
    while True:
        chunk = s.recv(65536)
        if not chunk:
            sys.exit(1)
        buf += chunk
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            try:
                msg = json.loads(line)
            except Exception:
                continue
            if msg.get("request_id") != 4242:
                continue
            if msg.get("error") != "success":
                sys.exit(1)
            data = msg.get("data")
            if mode == "1" and data is not None:
                print("true" if data is True else "false" if data is False else data)
            elif mode == "2":
                print(json.dumps(data))
            sys.exit(0)
except Exception:
    sys.exit(1)
PYEOF

mpv_ipc() {
  local cmd_json="$1" mode="${2:-0}"
  [[ -S "$MPV_SOCKET" ]] || return 1
  python3 -c "$IPC_PY" "$MPV_SOCKET" "$cmd_json" "$mode"
}

# ---------- local LLM (Ollama or any OpenAI-compatible server) ----------

llm_base() { local b="${LLM_URL%/}"; printf '%s' "${b%/v1}"; }

llm_available() {
  local base; base=$(llm_base)
  local args=(-sf --max-time 3)
  [[ -n "$LLM_API_KEY" ]] && args+=(-H "Authorization: Bearer $LLM_API_KEY")
  if [[ "$LLM_BACKEND" == openai ]]; then
    curl "${args[@]}" "$base/v1/models" >/dev/null 2>&1
  else
    curl "${args[@]}" "$base/api/tags" >/dev/null 2>&1
  fi
}

LLM_PY=''
read -r -d '' LLM_PY <<'PYEOF' || true
import sys, os, json, re, urllib.request, urllib.error
backend, base, model, timeout = sys.argv[1], sys.argv[2], sys.argv[3], float(sys.argv[4])
system = os.environ.get("TUNES_LLM_SYSTEM", "")
user = sys.stdin.read()
headers = {"Content-Type": "application/json"}
if os.environ.get("LLM_API_KEY"):
    headers["Authorization"] = "Bearer " + os.environ["LLM_API_KEY"]
if backend == "openai":
    url = base + "/v1/chat/completions"
    payload = {"model": model, "temperature": 0.7, "stream": False,
               "messages": [{"role": "system", "content": system},
                            {"role": "user", "content": user}]}
else:
    url = base + "/api/generate"
    payload = {"model": model, "prompt": user, "system": system, "stream": False,
               "options": {"temperature": 0.7}}
req = urllib.request.Request(url, data=json.dumps(payload).encode(), headers=headers)
try:
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        data = json.loads(resp.read().decode())
except urllib.error.HTTPError as e:
    body = ""
    try:
        body = e.read().decode(errors="ignore")[:200]
    except Exception:
        pass
    hint = f" (model '{model}' not found? try: ollama pull {model})" if e.code == 404 and backend != "openai" else ""
    print(f"LLM request failed: HTTP {e.code} {body}{hint}", file=sys.stderr)
    sys.exit(1)
except Exception as e:
    print(f"LLM request failed: {e}", file=sys.stderr)
    sys.exit(1)
if backend == "openai":
    text = ((data.get("choices") or [{}])[0].get("message") or {}).get("content", "")
else:
    text = data.get("response", "")
text = re.sub(r"<think>.*?</think>", "", text or "", flags=re.S).strip()
print(text)
PYEOF

# Sends a prompt to the configured local model; prints the reply on stdout.
llm_ask() {
  local system="$1" user="$2"
  command -v curl >/dev/null 2>&1 || { echo "⚠ curl is required for AI features" >&2; return 1; }
  if ! llm_available; then
    echo "⚠ Local LLM not reachable at ${LLM_URL} (${LLM_BACKEND}). Check it with: tunes ai test" >&2
    return 1
  fi
  TUNES_LLM_SYSTEM="$system" LLM_API_KEY="$LLM_API_KEY" \
    python3 -c "$LLM_PY" "$LLM_BACKEND" "$(llm_base)" "$LLM_MODEL" "$LLM_TIMEOUT" <<<"$user"
}


# Wrapper for desktop notifications
desktop_notify() {
  local summary="$1" body="${2:-}" icon="${3:-audio-headphones}" extra_args=("${@:4}")
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Tunes" -i "$icon" -h "string:desktop-entry:tunes" "${extra_args[@]}" "$summary" "$body" 2>/dev/null || true
  fi
}

cleanup_stale_socket() {
  if [[ -S "$MPV_SOCKET" ]]; then
    if ! mpv_ipc '["get_property", "pid"]' 0 >/dev/null 2>&1; then
      rm -f "$MPV_SOCKET"
    fi
  fi
}

# Strip common YouTube title clutter so lyrics tools (sptlrx) can match artist/title.
clean_title() {
  local t="$1"
  t=$(sed -E '
    s/[\(\[][^)\]]*(official|video|audio|lyrics?|hd|hq|4k|visualizer|remastered|mv|m\/v)[^)\]]*[\)\]]//Ig;
    s/\s*[-–]\s*(Topic)\s*$//I;
    s/\bft\.?\s+/feat. /Ig;
    s/\s{2,}/ /g;
    s/^\s+|\s+$//g;
    s/\s*[-–]\s*$//
  ' <<< "$t")
  echo "$t"
}


# Safely de-duplicate a TSV file by exact URL (column 2). Never truncates on failure.
dedupe_tsv_by_url() {
  local file="$1" url="$2"
  [[ -f "$file" ]] || return 0
  if URL="$url" awk -F'\t' '$2 != ENVIRON["URL"]' "$file" > "$file.tmp" 2>/dev/null; then
    mv "$file.tmp" "$file"
  else
    rm -f "$file.tmp"
  fi
}

# Recently played list (unique tracks, newest first, capped at 200).
log_history() {
  local title url
  title=$(sanitize_field "$1"); url=$(sanitize_field "$2")
  [[ -z "$url" ]] && return 0
  dedupe_tsv_by_url "$HISTORY_FILE" "$url"
  { printf '%s\t%s\n' "$title" "$url"; cat "$HISTORY_FILE" 2>/dev/null || true; } > "$HISTORY_FILE.tmp"
  head -n 200 "$HISTORY_FILE.tmp" > "$HISTORY_FILE"
  rm -f "$HISTORY_FILE.tmp"
}

# ---------- mpv launcher ----------
# All mpv arguments are built as arrays (no word-splitting surprises).

YT_ARGS=()
yt_args() {
  case "${AUDIO_QUALITY:-highest}" in
    highest)
      YT_ARGS=(--ytdl-format="bestaudio[acodec=opus]/bestaudio[ext=webm]/bestaudio/best")
      YT_ARGS+=(--ytdl-raw-options-append='format-sort=abr,asr,ext:opus:m4a')
      ;;
    high)
      YT_ARGS=(--ytdl-format="bestaudio/best")
      ;;
    standard)
      YT_ARGS=(--ytdl-format="ba[abr<=128]/bestaudio/best")
      ;;
  esac
  if command -v node >/dev/null 2>&1; then
    YT_ARGS+=(--ytdl-raw-options-append="js-runtimes=node")
  elif command -v deno >/dev/null 2>&1; then
    YT_ARGS+=(--ytdl-raw-options-append="js-runtimes=deno")
  fi
  if [[ -n "${YT_CLIENT:-}" ]]; then
    YT_ARGS+=("--ytdl-raw-options-append=extractor-args=youtube:player_client=$YT_CLIENT")
  fi
  return 0
}

MPV_BASE=()
build_mpv_args() {
  ensure_integration
  ensure_tracker
  MPV_BASE=(--input-ipc-server="$MPV_SOCKET")
  [[ -f "$SCRIPTS_DIR/tunes-notify.lua" ]] && MPV_BASE+=(--scripts-append="$SCRIPTS_DIR/tunes-notify.lua")
  [[ -f "$SCRIPTS_DIR/tunes-track.lua" ]] && MPV_BASE+=(--scripts-append="$SCRIPTS_DIR/tunes-track.lua")
  if [[ -f "$SCRIPTS_DIR/mpris.so" && ! -f "$HOME/.config/mpv/scripts/mpris.so" ]]; then
    MPV_BASE+=(--scripts-append="$SCRIPTS_DIR/mpris.so")
  fi
  ensure_autoplay
  [[ -f "$SCRIPTS_DIR/tunes-autoplay.lua" ]] && MPV_BASE+=(--scripts-append="$SCRIPTS_DIR/tunes-autoplay.lua")
  if [[ "$DEFAULT_VOLUME" =~ ^[0-9]+$ ]]; then MPV_BASE+=(--volume="$DEFAULT_VOLUME"); fi

  # Audio output: longer resampler filter, gapless playback, no digital gain above 100%
  MPV_BASE+=(
    --audio-resample-filter-size=32
    --gapless-audio=yes
    --volume-max=100
    --audio-buffer=0.4
  )
  [[ "${REPLAYGAIN:-off}" =~ ^(track|album)$ ]] && MPV_BASE+=(--replaygain="$REPLAYGAIN")

  # Optional audio DSP (off unless AUDIO_ENHANCE=on)
  local af_str
  af_str=$(get_audio_filter_string)
  if [[ -n "$af_str" ]]; then
    MPV_BASE+=(--af="$af_str")
  fi
  return 0
}

# Starting something new replaces whatever tunes is already playing.
stop_previous() {
  if mpv_ipc '["get_property","pid"]' 0 >/dev/null 2>&1; then
    mpv_ipc '["quit"]' 0 >/dev/null 2>&1 || true
    sleep 0.4
  fi
  cleanup_stale_socket
}

# launch_mpv <kind: music|podcast|video> <label> <mpv args...>
launch_mpv() {
  local kind="$1" label="$2"; shift 2
  stop_previous
  build_mpv_args
  export TUNES_PLAYS_FILE="$PLAYS_FILE" TUNES_KIND="$kind"
  export TUNES_BIN="$SELF" TUNES_DATA_DIR="$DATA_DIR"
  export TUNES_AUTOPLAY_FILE="$AUTOPLAY_STATE_FILE" TUNES_AUTOPLAY="${AUTOPLAY:-on}"
  if [[ "${DETACH:-0}" == "1" ]]; then
    nohup mpv "${MPV_BASE[@]}" "$@" </dev/null >"$LOG_FILE" 2>&1 &
    local pid=$!
    disown "$pid"
    echo "▶ $label (background)"
    echo "  (PID $pid — control with: tunes ctl <action>, tunes status)"
    desktop_notify "Now Playing (Background)" "$label" "audio-headphones"
  else
    echo "▶ $label"
    mpv "${MPV_BASE[@]}" --term-osd-bar "$@" || true
  fi
  return 0
}

play_url() {
  local title="$1" url="$2" clean extra=()
  clean=$(clean_title "$title")
  log_history "$title" "$url"
  [[ "${LOOP:-0}" == "1" ]] && extra+=(--loop-file=inf)
  yt_args
  local suffix=""; [[ "${LOOP:-0}" == "1" ]] && suffix=" (looping)"
  launch_mpv music "Playing: ${clean}${suffix}" --no-video "${YT_ARGS[@]}" \
    --force-media-title="$clean" "${extra[@]}" "$url"
}

# play_queue <label> <tsv>   (each line: title<TAB>url[<TAB>...])
play_queue() {
  local label="$1" tsv="$2" title url rest clean count=0
  printf '#EXTM3U\n' > "$QUEUE_FILE"
  while IFS=$'\t' read -r title url rest; do
    [[ -z "$url" ]] && continue
    clean=$(clean_title "$title")
    log_history "$title" "$url"
    printf '#EXTINF:-1,%s\n%s\n' "$clean" "$url" >> "$QUEUE_FILE"
    count=$((count + 1))
  done <<< "$tsv"
  if ((count == 0)); then echo "Nothing to play."; return 0; fi
  local extra=()
  [[ "${LOOP:-0}" == "1" ]] && extra+=(--loop-playlist=inf)
  [[ "${SHUFFLE:-0}" == "1" ]] && extra+=(--shuffle)
  yt_args
  launch_mpv music "$label ($count tracks)" --no-video "${YT_ARGS[@]}" "${extra[@]}" "$QUEUE_FILE"
}

# ---------- search / pickers ----------

search_and_pick() {
  local query="$1" count="${2:-15}" out
  echo "Searching: $query ..." >&2
  out=$(yt-dlp "ytsearch${count}:${query}" --flat-playlist -j 2>/dev/null || true)
  if [[ -z "$out" ]]; then
    echo "No results (network down, or yt-dlp is outdated — try: yt-dlp -U)." >&2
    return 0
  fi
  jq -r '[.title, (.url // ("https://www.youtube.com/watch?v=" + .id)), (.channel // .uploader // ""), (.duration_string // "")]
         | map(tostring | gsub("[\\t\\n\\r]"; " ")) | join("\t")' <<<"$out" 2>/dev/null || true
}


pick_from_list() {
  local prompt="${1:-🎵 > }"
  # reads tab-separated title\turl[\tchannel\tduration] from stdin
  fzf --delimiter='\t' --with-nth=1,3,4 \
      --prompt="$prompt" --height=60% --border --reverse \
      --preview='echo -e "Title:    \033[1m{1}\033[0m\nChannel:  {3}\nDuration: {4}\nURL:      {2}"' \
      --preview-window="down:4:wrap:hidden" --bind="?:toggle-preview"
}

# ---------- word-frequency helper (used by recommend) ----------
top_words() {
  local n="${1:-3}"
  tr '[:upper:]' '[:lower:]' \
    | tr -c 'a-z0-9' '\n' \
    | grep -vE '^(the|and|feat|ft|official|video|audio|lyrics|remix|mv|hd|hq|with|for|from|of|to|in|on|a|an|is|by|ep|vol|part|full|album|song|music|podcast|episode)$' \
    | awk 'length($0)>2' \
    | sort | uniq -c | sort -rn \
    | head -n "$n" | awk '{print $2}'
}

# Cleans numbered/bulleted/quoted LLM output into plain lines, capped at N.
llm_lines_to_list() {
  local n="${1:-5}"
  sed -E 's/\r$//; s/^[[:space:]]*([-*•]+|[0-9]+[.):])[[:space:]]*//; s/^[[:space:]]*([-*•]+|[0-9]+[.):])[[:space:]]*//' \
    | sed -E 's/^[[:space:]]*[*_"`]+//; s/[*_"`]+[[:space:]]*$//' \
    | grep -v '^[[:space:]]*$' \
    | head -n "$n" || true
}

# ---------- podcast helpers (RSS via python3, no extra deps) ----------

# Parses an RSS feed URL, prints title\tenclosure_url\tfeed_name\tpubdate per episode
pod_parse_feed() {
  local url="$1" limit="${2:-30}" feed_name="${3:-}"
  curl -sL --max-time 15 "$url" 2>/dev/null | python3 <(cat <<'PYEOF'
import sys, xml.etree.ElementTree as ET
limit = int(sys.argv[1])
feed_name = sys.argv[2] if len(sys.argv) > 2 else ""
data = sys.stdin.buffer.read()
try:
    root = ET.fromstring(data)
except Exception:
    sys.exit(0)

if not feed_name:
    ch_title = root.find('.//channel/title')
    feed_name = (ch_title.text or '').strip().replace('\t', ' ') if ch_title is not None else 'Podcast'

items = root.findall('.//item')[:limit]
for it in items:
    title_el = it.find('title')
    title = (title_el.text or '').strip().replace('\t', ' ') if title_el is not None else 'Untitled'
    enc = it.find('enclosure')
    link = enc.get('url') if enc is not None and enc.get('url') else None
    if not link:
        link_el = it.find('link')
        link = link_el.text.strip() if link_el is not None and link_el.text else None
    pub_el = it.find('pubDate')
    pub = (pub_el.text or '').strip() if pub_el is not None else ''
    if link:
        print(f"{title}\t{link}\t{feed_name}\t{pub}")
PYEOF
) "$limit" "$feed_name" 2>/dev/null || true
  return 0
}

# iTunes Search API lookup (free, no key) -> name\tfeed_url
pod_itunes_search() {
  local query="$1" limit="${2:-10}"
  curl -sL --max-time 15 "https://itunes.apple.com/search?media=podcast&limit=${limit}&term=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$query")" 2>/dev/null \
    | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for r in data.get('results', []):
    name = (r.get('collectionName') or 'Unknown').replace('\t',' ')
    feed = r.get('feedUrl')
    if feed:
        print(f'{name}\t{feed}')
" 2>/dev/null || true
  return 0
}


