now_playing_line() {
  local t p
  t=$(mpv_ipc '["get_property","media-title"]' 1 2>/dev/null) || return 0
  p=$(mpv_ipc '["get_property","pause"]' 1 2>/dev/null || echo false)
  if [[ "$p" == "true" ]]; then echo "⏸  $t"; else echo "▶  $t"; fi
}

menu_items() {
  printf '%s\t%s\n' \
    "search"        "🔎  Search & play" \
    "queue"         "🎚  Build a queue (multi-select)" \
    "top"           "🔥  Most played" \
    "mix"           "🎲  My mix (from your favourites & top tracks)" \
    "favorites"     "★   Favourites" \
