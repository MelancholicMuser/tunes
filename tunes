# stats_engine <stats|report|top|context|json|count> [--period P] [--limit N]
stats_engine() {
  local mode="$1"; shift
  local color=()
  if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then color=(--color); fi
  TUNES_THRESH="$PLAY_THRESHOLD" python3 -c "$STATS_PY" "$mode" "$PLAYS_FILE" "${color[@]}" "$@"
}

mark_report() { date +%s > "$LAST_REPORT_FILE" 2>/dev/null || true; }

# One-line nudge (used by the home menu) when a week has passed since the last report.
report_reminder() {
  [[ "$REPORT_REMINDER" == "off" ]] && return 0
  local last=0 now n
  now=$(date +%s)
  [[ -f "$LAST_REPORT_FILE" ]] && last=$(cat "$LAST_REPORT_FILE" 2>/dev/null || echo 0)
  [[ "$last" =~ ^[0-9]+$ ]] || last=0
  if ((now - last >= 7 * 86400)); then
    n=$(stats_engine count --period week 2>/dev/null || echo 0)
    if [[ "$n" =~ ^[0-9]+$ ]] && ((n > 0)); then
      echo "📰 Your weekly report is ready ($n plays this week) — open 'Listening report'"
    fi
  fi
  return 0
}

cmd_stats() {
  local period="all" arg json=0
  for arg in "$@"; do
    case "$arg" in
      --json) json=1 ;;
      -*) echo "Usage: tunes stats [today|week|month|year|all|<N>d|YYYY-MM-DD] [--json]" >&2; exit 1 ;;
      *) period="$arg" ;;
    esac
  done
  if ((json)); then stats_engine json --period "$period"; return 0; fi
  stats_engine stats --period "$period"
  local favs feeds pls
  favs=$(grep -c . "$FAVORITES_FILE" 2>/dev/null || true)
  feeds=$(grep -c . "$FEEDS_FILE" 2>/dev/null || true)
  pls=$(find "$PLAYLISTS_DIR" -maxdepth 1 -name '*.tsv' 2>/dev/null | grep -c . || true)
  echo " ▸ Library: ★ ${favs:-0} favourites · 📂 ${pls:-0} playlists · 🎙 ${feeds:-0} podcast feeds"
}

REPORT_SYS="You write short, friendly listening reports for a terminal music player, based on a data digest. Use ONLY facts and numbers that appear in the digest — never invent songs, artists, genres or numbers. Write 4 to 6 sentences of plain prose (no markdown, no bullet points, no headings): name the top track and artist, point out one pattern (time of day or weekday), mention the change versus the previous period if one is given, and end with one concrete suggestion for what to explore next."

ASK_SYS="You are a friendly analyst of the user's music listening habits. You are given a data digest for several periods. Answer the question using ONLY the data provided. If the data cannot answer it, say so plainly. Be concise (a short paragraph or a few lines), do not invent songs, artists or numbers, and do not use markdown."

wrap_text() { fold -s -w "${1:-80}"; }

# tunes report [period] [--ai] [--save] [--notify] [--json]
cmd_report() {
  local period="week" ai=0 save=0 notify=0 json=0 card=0
  while (($#)); do
    case "$1" in
      --ai) ai=1 ;;
      --save) save=1 ;;
      --notify) notify=1 ;;
      --json) json=1 ;;
      --card) card=1 ;;
      -h|--help)
        cat <<'USAGE'
Usage: tunes report [period] [--ai] [--save] [--notify] [--json] [--card]
  period   today | yesterday | week (default) | month | year | all | <N>d | <N>w | YYYY-MM-DD | YYYY-MM
  --ai     add a short written take from your local LLM (see: tunes ai setup)
  --save   also write the report to ~/.local/share/tunes/reports/
  --notify send a desktop notification with the headline numbers
  --json   print the raw numbers as JSON
  --card   print a short shareable text card (paste it anywhere)
USAGE
        return 0 ;;
      -*) echo "Unknown option: $1 (try: tunes report --help)" >&2; exit 1 ;;
      *) period="$1" ;;
    esac
    shift
  done

  if ((json)); then stats_engine json --period "$period"; mark_report; return 0; fi
  if ((card)); then report_card "$period"; mark_report; return 0; fi

  stats_engine report --period "$period"
  mark_report

  local plays
  plays=$(stats_engine count --period "$period")
  local ai_text=""
  if ((ai)); then
    echo
    if ((plays == 0)); then
      echo "🤖 Nothing to analyse yet — listen to a few tracks first."
    else
      echo "🤖 Asking ${LLM_MODEL} for its take ..." >&2
      if ai_text=$(llm_ask "$REPORT_SYS" "$(stats_engine context --period "$period")"); then
        echo "🤖 AI take ($LLM_MODEL)"
        printf '%s\n' "$ai_text" | wrap_text 80 | sed 's/^/   /'
      else
        ai_text=""
        echo "   (AI take unavailable — connect a local model with: tunes ai setup)"
      fi
    fi
  fi

  if ((save)); then
    mkdir -p "$REPORTS_DIR"
    local out
    out="$REPORTS_DIR/report-$(date +%F)-${period//[^A-Za-z0-9_-]/_}.txt"
    {
      NO_COLOR=1 stats_engine report --period "$period" | cat
      if [[ -n "$ai_text" ]]; then
        printf '\nAI take (%s)\n' "$LLM_MODEL"
        printf '%s\n' "$ai_text" | wrap_text 80 | sed 's/^/   /'
      fi
    } > "$out"
    echo; echo "💾 Saved: $out"
  fi

  if ((notify)); then
    local top
    top=$(stats_engine top --period "$period" --limit 1 | cut -f1 || true)
    desktop_notify "Tunes report ($period)" "${plays} plays${top:+ · top track: $top}" "audio-headphones"
  fi
  return 0
}

# tunes ask "which artist did I listen to most on weekends?"
cmd_ask() {
  local q="$*"
  [[ -z "$q" ]] && read -rp "Ask about your listening: " q
  [[ -z "$q" ]] && exit 0
  local total
  total=$(stats_engine count --period all)
  if ((total == 0)); then echo "No listening data yet — play some tracks first."; exit 0; fi
  local ctx
  ctx="=== Last 7 days ===
$(stats_engine context --period week)

=== Last 30 days ===
$(stats_engine context --period month)

=== All time ===
$(stats_engine context --period all)"
  echo "Thinking ..." >&2
  local ans
  ans=$(llm_ask "$ASK_SYS" "$ctx"$'\n\n'"Question: $q") || exit 1
  printf '\n%s\n' "$ans" | wrap_text 80
}

# tunes top [period]  — browse & play your most-played tracks
# tunes top [period] [-n COUNT] [--save NAME]
cmd_top() {
  local period="all" save="" limit=100 rows usage="Usage: tunes top [period] [-n COUNT] [--save PLAYLIST]"
  while (($#)); do
    case "$1" in
      --save) save="${2:-}"; [[ -n "$save" ]] || { echo "$usage" >&2; return 1; }; shift 2 ;;
      -n|--limit) limit="${2:-}"; { [[ "$limit" =~ ^[0-9]+$ ]] && ((10#$limit > 0)); } || { echo "$usage" >&2; return 1; }; shift 2 ;;
      -h|--help) echo "$usage"; return 0 ;;
      -*) echo "Unknown option: $1 ($usage)" >&2; return 1 ;;
      *) period="$1"; shift ;;
    esac
  done
  rows=$(stats_engine top --period "$period" --limit "$limit")
  if [[ -z "$rows" ]]; then echo "No plays logged for '$period' yet — go listen to something!"; exit 0; fi
  if [[ -n "$save" ]]; then save_rows_as_playlist "$save" "$(cut -f1,2 <<<"$rows")"; return 0; fi
  play_stats_rows "Most played ($period)" "🔥 most played ($period) > " "$rows"
}

shuffle_lines() { if command -v shuf >/dev/null 2>&1; then shuf; else sort -R; fi; }

# tunes mix [N]  — a personal shuffle built from your most-played tracks + favourites
cmd_mix() {
  local n="${1:-25}"
  [[ "$n" =~ ^[0-9]+$ ]] && ((n > 0)) || { echo "Usage: tunes mix [number-of-tracks]"; exit 1; }
  local pool picks
  pool=$({ stats_engine top --period all --limit 60 | cut -f1,2; cat "$FAVORITES_FILE" 2>/dev/null || true; } \
         | awk -F'\t' 'NF >= 2 && !seen[$2]++')
  if [[ -z "$pool" ]]; then echo "Nothing to mix yet — listen to a few tracks or add favourites first."; exit 0; fi
  picks=$(printf '%s\n' "$pool" | shuffle_lines | awk -v n="$n" 'NR <= n')
  play_queue "Your mix" "$picks"
}

# tunes add [query]  — append tracks to the queue that is playing right now
cmd_add() {
  local query="${1:-}"
  if ! mpv_ipc '["get_property","pid"]' 0 >/dev/null 2>&1; then
    echo "Nothing is playing — starting a new session instead."
    cmd_search "$query"; return 0
  fi
  [[ -z "$query" ]] && read -rp "Add to queue — search: " query
  [[ -z "$query" ]] && exit 0
  local selections title url rest
  selections=$(search_and_pick "$query" | pick_multi "➕ add to queue (tab for several) > ") || exit 0
  while IFS=$'\t' read -r title url rest; do
    [[ -z "$url" ]] && continue
    log_history "$title" "$url"
    if mpv_ipc "$(jq -cn --arg u "$url" '["loadfile",$u,"append-play"]')" 0; then
      echo "➕ Queued: $title"
    else
      echo "✗ Could not queue: $title"
    fi
  done <<< "$selections"
}

# ======================================================================
#  Autoplay / Up Next  — Spotify-style "Radio" that never stops
# ======================================================================

# Internal command called by tunes-autoplay.lua when the queue is nearly
# exhausted.  Fetches similar tracks via YouTube's Radio Mix, writes them
# to a temp m3u, and prints the m3u path on stdout.  mpv loadlist-appends
# it so playback never stops.
__upnext_fetch() {
  local url="$1" title="${2:-}"
  [[ -z "$url" ]] && exit 1

  # Extract a YouTube video ID from the URL if present
  local vid=""
  if [[ "$url" =~ youtube\.com/watch\?v=([A-Za-z0-9_-]+) ]]; then
    vid="${BASH_REMATCH[1]}"
  elif [[ "$url" =~ youtu\.be/([A-Za-z0-9_-]+) ]]; then
    vid="${BASH_REMATCH[1]}"
  fi

  local tracks=""

  # Strategy 1: YouTube Radio Mix (RD{vid}) — most similar
  if [[ -n "$vid" ]]; then
    tracks=$(yt-dlp --flat-playlist --dump-json --no-warnings \
      -I "2:7" "https://www.youtube.com/watch?v=${vid}&list=RD${vid}" 2>/dev/null \
      | jq -r '[.title, (.url // ("https://www.youtube.com/watch?v=" + .id))] | @tsv' 2>/dev/null \
      | awk -F'\t' 'NF==2 && $1!="" && $2!=""' || true)
  fi

  # Strategy 2: keyword search derived from history (fallback)
  if [[ -z "$tracks" ]]; then
    local kw
    kw=$(clean_title "$title" | top_words 2 2>/dev/null \
      | head -n 1 | tr '\n' ' ' || true)
    [[ -z "$kw" ]] && exit 0
    tracks=$(search_and_pick "$kw" 6 2>/dev/null | head -n 5 || true)
  fi

  [[ -z "$tracks" ]] && exit 0

  # Exclude URLs already in the current mpv playlist to avoid repeats
  local played_urls
  played_urls=$(mpv_ipc '["get_property","playlist"]' 2 2>/dev/null \
    | python3 -c 'import sys,json; [print(e.get("filename","")) for e in json.load(sys.stdin)]' \
    2>/dev/null || true)

  local m3u
  m3u=$(mktemp "${RUNTIME_BASE}/tunes-upnext-XXXXXX.m3u")
  printf '#EXTM3U\n' > "$m3u"
  local count=0
  while IFS=$'\t' read -r t u; do
    [[ -z "$u" ]] && continue
    if echo "$played_urls" | grep -qF "$u" 2>/dev/null; then continue; fi
    clean=$(clean_title "$t")
    log_history "$t" "$u"
    printf '#EXTINF:-1,%s\n%s\n' "$clean" "$u" >> "$m3u"
    count=$((count + 1))
  done <<< "$tracks"

  if (( count == 0 )); then rm -f "$m3u"; exit 0; fi
  printf '%s\n' "$m3u"
}

# Toggle / query autoplay state, or show the interactive Up Next panel.
cmd_autoplay() {
  local sub="${1:-status}"
  case "$sub" in
    on)
      set_autoplay_state "on"
      # If something is already playing, hot-patch the state file (Lua reads it on-demand)
      echo "✅ Autoplay ON — similar tracks will be queued automatically"
      desktop_notify "Tunes" "Autoplay enabled" "media-playlist-repeat" 2>/dev/null || true
      ;;
    off)
      set_autoplay_state "off"
      echo "⏹ Autoplay OFF"
      desktop_notify "Tunes" "Autoplay disabled" "media-playlist-repeat" 2>/dev/null || true
      ;;
    toggle)
      local cur; cur=$(get_autoplay_state)
      if [[ "$cur" == "off" ]]; then cmd_autoplay on; else cmd_autoplay off; fi
      ;;
    status|"")
      local cur; cur=$(get_autoplay_state)
      if [[ "$cur" == "off" ]]; then
        echo "Autoplay: OFF  (tunes autoplay on  — to enable)"
      else
        echo "Autoplay: ON   (tunes autoplay off — to disable)"
      fi
      ;;
    *)
      echo "Usage: tunes autoplay [on|off|toggle|status]" >&2; return 1 ;;
  esac
}

# Show and interact with the Up Next queue (tracks scheduled to play after the
# current one, including autoplay suggestions).
cmd_upnext() {
  if ! mpv_ipc '["get_property","pid"]' 0 >/dev/null 2>&1; then
    echo "Nothing is playing."; return 0
  fi

  local ap; ap=$(get_autoplay_state)
  local ap_indicator; [[ "$ap" == "off" ]] && ap_indicator=" [Autoplay OFF]" || ap_indicator=" [Autoplay ON]"

  local pl
  pl=$(mpv_ipc '["get_property","playlist"]' 2) || { echo "Could not read queue."; return 0; }

  local action
  action=$(python3 - "$pl" <<'PYEOF'
import sys, json

data = json.loads(sys.argv[1])
cur_idx = next((i for i, e in enumerate(data) if e.get("current")), 0)

print("  [Now Playing]")
for i, e in enumerate(data):
    title = e.get("title") or e.get("filename", "Unknown")
    if len(title) > 72:
        title = title[:69] + "…"
    prefix = "▶" if e.get("current") else " "
    num = i + 1
    if i < cur_idx:
        print(f"  {prefix} {num:2}. {title}")
    elif e.get("current"):
        print(f"  {prefix} {num:2}. {title}  ← now playing")
    else:
        print(f"  {prefix} {num:2}. {title}")
PYEOF
  )

  echo "🎵 Up Next queue${ap_indicator}:"
  echo "$action"
  echo
  echo "  Commands: tunes add [query]  — add to queue"
  echo "            tunes ctl jump N   — jump to entry N"
  echo "            tunes ctl next     — skip to next"
  echo "            tunes autoplay on|off|toggle"
}

