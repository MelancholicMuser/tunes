controls_menu() {
  local act parts
  while true; do
    local np; np=$(now_playing_line || true)
    local ap_label; ap_label=$(get_autoplay_state)
    [[ "$ap_label" == "off" ]] && ap_label="🔀  Autoplay: OFF (toggle on)" || ap_label="🔀  Autoplay: ON  (toggle off)"
    act=$(printf '%s\t%s\n' \
      "pause"              "⏯   Play / pause" \
      "next"               "⏭   Next track" \
      "prev"               "⏮   Previous track" \
      "vol-up"             "🔊  Volume up" \
      "vol-down"           "🔉  Volume down" \
      "mute"               "🔇  Mute / unmute" \
      "enhance-toggle"     "✨  Audio enhance: toggle on/off" \
      "enhance-preset"     "🎚  Audio preset: select profile" \
      "seek +15"           "⏩  Forward 15s" \
      "seek -15"           "⏪  Back 15s" \
      "loop-toggle"        "🔁  Toggle loop" \
      "autoplay-toggle"    "$ap_label" \
      "queue"              "📜  Show queue" \
      "upnext"             "🎵  Up Next / autoplay queue" \
      "stop"               "⏹   Stop" \
      | fzf --delimiter='\t' --with-nth=2 --prompt="controls > " --header="${np:-Nothing playing}" \
            --height=55% --border --reverse | cut -f1) || return 0
    [[ -z "$act" ]] && return 0
    case "$act" in
      autoplay-toggle)
        "$SELF" autoplay toggle || true
        sleep 0.4 ;;
      enhance-toggle)
        "$SELF" ctl enhance toggle || true
        sleep 0.4 ;;
      enhance-preset)
        local chosen_preset
        chosen_preset=$(printf '%s\t%s\n' \
          "crystalizer" "Crystalizer (sharper transients, wider dynamics)" \
          "clarity"     "Clarity / Vocal (Sparkle + vocal presence)" \
          "warm"        "Warm (Crystalizer + rich sub-bass warmth)" \
          "bass"        "Bass Boost (Punchy low end + crystalizer)" \
          "spatial"     "Spatial Widen (Subtle stereo soundstage widening)" \
          "norm"        "Loudness Normalization (EBU R128)" \
          "studio"      "Studio Direct (no filters)" \
          "custom"      "Custom (your AUDIO_CUSTOM_AF filter chain)" \
          | fzf --delimiter='\t' --with-nth=2 --prompt="preset > " --height=45% --border --reverse | cut -f1) || true
        if [[ -n "$chosen_preset" ]]; then
          "$SELF" ctl enhance "$chosen_preset" || true
          config_set AUDIO_PRESET "$chosen_preset" 2>/dev/null || true
          sleep 0.4
        fi ;;
      upnext)
        "$SELF" upnext || true
        read -rp "↵ " _ || true ;;
      queue)
        IFS=' ' read -ra parts <<< "$act"
        "$SELF" ctl "${parts[@]}" || true
        read -rp "↵ " _ || true ;;
      *)
        IFS=' ' read -ra parts <<< "$act"
        "$SELF" ctl "${parts[@]}" || true ;;
    esac
  done
}
cmd_home() {
  if [[ ! -t 0 || ! -t 1 ]]; then cmd_help; return 0; fi
  local choice key parts np rem header
  while true; do
    np=$(now_playing_line || true)
    rem=$(report_reminder || true)
    header="🎵 tunes $TUNES_VERSION"
    [[ -n "$np" ]] && header+=$'\n'"$np"
    [[ -n "$rem" ]] && header+=$'\n'"$rem"
    choice=$(menu_items | fzf --delimiter='\t' --with-nth=2 --prompt="tunes > " --header="$header" \
              --height=85% --border --reverse) || break
    key=$(cut -f1 <<<"$choice")
    case "$key" in
      quit|"") break ;;
      ctl-menu) controls_menu ;;
      *)
        IFS=' ' read -ra parts <<<"$key"
        "$SELF" "${parts[@]}" || true
        case "$key" in
          report*|ask|stats|config) read -rp "↵ back to menu " _ || true ;;
        esac
        ;;
    esac
  done
}


