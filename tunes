# Extended transport controls with desktop feedback
cmd_ctl() {
  local action="${1:-}" arg="${2:-}"
  case "$action" in
    vol-up|vol-down|vol|mute|seek|speed|loop-on|loop-off|loop-toggle|queue|list|jump|goto|enhance|preset)
      if ! mpv_ipc '["get_property","pid"]' 0 >/dev/null 2>&1; then
        echo "Nothing is playing."; return 1
      fi ;;
  esac
  case "$action" in
    enhance|preset)
      local mode="${arg:-toggle}"
      local cur_af
      cur_af=$(mpv_ipc '["get_property", "af"]' 2 2>/dev/null || echo "[]")
      local is_active=0
      [[ "$cur_af" != "[]" && -n "$cur_af" && "$cur_af" != "null" ]] && is_active=1

      case "$mode" in
        toggle)
          if ((is_active)); then
            mpv_ipc '["set_property_string", "af", ""]' 0
            AUDIO_ENHANCE="off"
            echo "✨ Audio Enhancement: OFF (no filters)"
            desktop_notify "Audio Enhancement" "Off" "audio-headphones"
          else
            local f
            f=$(get_audio_filter_string "on" "$AUDIO_PRESET")
            mpv_ipc "[\"set_property_string\", \"af\", \"$f\"]" 0
            AUDIO_ENHANCE="on"
            echo "✨ Audio Enhancement: ON (Preset: $AUDIO_PRESET)"
            desktop_notify "Audio Enhancement" "Active ($AUDIO_PRESET)" "audio-headphones"
          fi
          ;;
        on)
          local f
          f=$(get_audio_filter_string "on" "$AUDIO_PRESET")
          mpv_ipc "[\"set_property_string\", \"af\", \"$f\"]" 0
          AUDIO_ENHANCE="on"
          echo "✨ Audio Enhancement: ON (Preset: $AUDIO_PRESET)"
          desktop_notify "Audio Enhancement" "Active ($AUDIO_PRESET)" "audio-headphones"
          ;;
        off|none|studio|flat)
          mpv_ipc '["set_property_string", "af", ""]' 0
          AUDIO_ENHANCE="off"
          echo "✨ Audio Enhancement: OFF (no filters)"
          desktop_notify "Audio Enhancement" "Off" "audio-headphones"
          ;;
        crystalizer|clarity|vocal|warm|bass|norm|r128|spatial|widen|custom)
          AUDIO_PRESET="$mode"
          AUDIO_ENHANCE="on"
          local f
          f=$(get_audio_filter_string "on" "$mode")
          mpv_ipc "[\"set_property_string\", \"af\", \"$f\"]" 0
          echo "✨ Audio Enhancement Preset: $mode"
          desktop_notify "Audio Enhancement" "Preset: $mode" "audio-headphones"
          ;;
        *)
          echo "Usage: tunes ctl enhance [on|off|toggle|crystalizer|clarity|warm|bass|norm|spatial|custom]"
          ;;
      esac
      ;;
    pause|play-pause)
      if mpv_ipc '["cycle", "pause"]' 0; then
        local p
        p=$(mpv_ipc '["get_property", "pause"]' 1 || echo "")
        if [[ "$p" == "true" ]]; then
          echo "⏸ Paused"
          desktop_notify "Tunes" "Playback Paused" "media-playback-pause" -h "string:x-canonical-private-synchronous:tunes-state"
        else
          echo "▶ Resumed"
          desktop_notify "Tunes" "Playback Resumed" "media-playback-start" -h "string:x-canonical-private-synchronous:tunes-state"
        fi
      elif command -v playerctl >/dev/null 2>&1; then
        playerctl play-pause
      fi
      ;;
    play)
      mpv_ipc '["set_property", "pause", false]' 0 || { command -v playerctl >/dev/null 2>&1 && playerctl play; }
      desktop_notify "Tunes" "Playback Resumed" "media-playback-start" -h "string:x-canonical-private-synchronous:tunes-state"
      echo "▶ Resumed"
      ;;
    stop|quit)
      mpv_ipc '["quit"]' 0 || { command -v playerctl >/dev/null 2>&1 && playerctl stop; }
      rm -f "$MPV_SOCKET"
      desktop_notify "Tunes" "Playback Stopped" "media-playback-stop" -h "string:x-canonical-private-synchronous:tunes-state"
      echo "⏹ Stopped"
      ;;
    next)
      mpv_ipc '["playlist-next"]' 0 || { command -v playerctl >/dev/null 2>&1 && playerctl next; }
      echo "⏭ Skipped to next"
      ;;
    prev)
      mpv_ipc '["playlist-prev"]' 0 || { command -v playerctl >/dev/null 2>&1 && playerctl previous; }
      echo "⏮ Skipped to previous"
      ;;
    vol-up)
      local step="${arg:-5}"
      [[ "$step" =~ ^[0-9]+$ ]] || { echo "Usage: tunes ctl vol-up|vol-down [percent]"; exit 1; }
      mpv_ipc "[\"add\", \"volume\", ${step}]" 0
      local vol
      vol=$(mpv_ipc '["get_property", "volume"]' 1 || echo "100")
      vol="${vol%.*}"
      desktop_notify "Volume" "${vol}%" "audio-volume-high" -h "string:x-canonical-private-synchronous:tunes-volume" -h "int:value:${vol}"
      echo "🔊 Volume: ${vol}%"
      ;;
    vol-down)
      local step="${arg:-5}"
      [[ "$step" =~ ^[0-9]+$ ]] || { echo "Usage: tunes ctl vol-up|vol-down [percent]"; exit 1; }
      mpv_ipc "[\"add\", \"volume\", -${step}]" 0
      local vol
      vol=$(mpv_ipc '["get_property", "volume"]' 1 || echo "100")
      vol="${vol%.*}"
      desktop_notify "Volume" "${vol}%" "audio-volume-medium" -h "string:x-canonical-private-synchronous:tunes-volume" -h "int:value:${vol}"
      echo "🔉 Volume: ${vol}%"
      ;;
    vol)
      [[ "$arg" =~ ^[0-9]+$ ]] && ((arg <= 150)) || { echo "Usage: tunes ctl vol <0-100>"; exit 1; }
      mpv_ipc "[\"set_property\", \"volume\", ${arg}]" 0
      desktop_notify "Volume" "${arg}%" "audio-volume-high" -h "string:x-canonical-private-synchronous:tunes-volume" -h "int:value:${arg}"
      echo "🔊 Volume set to: ${arg}%"
      ;;
    mute)
      mpv_ipc '["cycle", "mute"]' 0
      local m
      m=$(mpv_ipc '["get_property", "mute"]' 1 || echo "")
      if [[ "$m" == "true" ]]; then
        desktop_notify "Volume" "Muted" "audio-volume-muted" -h "string:x-canonical-private-synchronous:tunes-volume"
        echo "🔇 Muted"
      else
        desktop_notify "Volume" "Unmuted" "audio-volume-high" -h "string:x-canonical-private-synchronous:tunes-volume"
        echo "🔊 Unmuted"
      fi
      ;;
    seek)
      local offset="${arg:-+10}"
      [[ "$offset" =~ ^[+-]?[0-9]+(\.[0-9]+)?$ ]] || { echo "Usage: tunes ctl seek <+/-seconds>"; exit 1; }
      offset="${offset#+}"   # JSON has no leading plus
      mpv_ipc "[\"seek\", ${offset}]" 0
      echo "⏩ Seeked ${offset}s"
      ;;
    speed)
      local sp="${arg:-1.0}"
      [[ "$sp" =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "Usage: tunes ctl speed <rate, e.g. 1.25>"; exit 1; }
      mpv_ipc "[\"set_property\", \"speed\", ${sp}]" 0
      desktop_notify "Speed" "${sp}x" "media-playback-start"
      echo "⚡ Playback speed: ${sp}x"
      ;;
    loop-on)
      mpv_ipc '["set_property", "loop-file", "inf"]' 0 && echo "🔁 Loop ON"
      desktop_notify "Tunes" "Loop Enabled" "media-playlist-repeat"
      ;;
    loop-off)
      mpv_ipc '["set_property", "loop-file", "no"]' 0 && echo "Loop OFF"
      desktop_notify "Tunes" "Loop Disabled" "media-playlist-repeat"
      ;;
    loop-toggle)
      mpv_ipc '["cycle-values", "loop-file", "inf", "no"]' 0
      local l
      l=$(mpv_ipc '["get_property", "loop-file"]' 1 || echo "")
      if [[ "$l" == "inf" ]]; then
        echo "🔁 Loop ON"
        desktop_notify "Tunes" "Loop Enabled" "media-playlist-repeat"
      else
        echo "Loop OFF"
        desktop_notify "Tunes" "Loop Disabled" "media-playlist-repeat"
      fi
      ;;
    queue|list)
      local pl
      pl=$(mpv_ipc '["get_property","playlist"]' 2) || { echo "Nothing is playing."; return 0; }
      python3 -c 'import sys,json
for i, e in enumerate(json.load(sys.stdin), 1):
    print("%s %2d. %s" % ("▶" if e.get("current") else " ", i, e.get("title") or e.get("filename")))' <<<"$pl"
      ;;
    jump|goto)
      [[ "$arg" =~ ^[0-9]+$ ]] && ((arg >= 1)) || { echo "Usage: tunes ctl jump <queue number>"; exit 1; }
      mpv_ipc "[\"playlist-play-index\", $((arg - 1))]" 0 && echo "⏭ Jumped to #$arg" || echo "No such queue entry."
      ;;
    status|info|np)
      cmd_status
      ;;
    *)
      cat <<EOF
Usage: tunes ctl {action} [args]

Actions:
  pause, play-pause     Toggle play/pause
  queue                 Show the current queue
  jump <n>              Jump to queue position n
  play                  Resume playback
  stop, quit            Stop playback and exit
  next                  Next track
  prev                  Previous track
  vol-up [step]         Increase volume (default: 5)
  vol-down [step]       Decrease volume (default: 5)
  vol <0-100>           Set volume level
  mute                  Toggle mute
  seek <+/-seconds>     Seek relative position (e.g. +15, -10)
  speed <rate>          Set playback speed (e.g. 1.25, 1.5)
  loop-toggle           Toggle looping on/off
  loop-on / loop-off    Turn looping on or off
  status                Show playback status
EOF
      exit 1
      ;;
  esac
}

# ---------- playlists ----------

playlist_path() { printf '%s/%s.tsv' "$PLAYLISTS_DIR" "$(sanitize_name "$1")"; }

# fzf over saved playlists; prints the chosen name
pick_playlist() {
  local names=() f
  for f in "$PLAYLISTS_DIR"/*.tsv; do
    if [[ -f "$f" ]]; then names+=("$(basename "$f" .tsv)"); fi
  done
  if ((${#names[@]} == 0)); then
    echo "No playlists yet. Create one with: tunes playlist create <name>" >&2
    return 1
  fi
  printf '%s\n' "${names[@]}" | fzf --prompt="📂 playlist > " --height=40% --border --reverse
}

cmd_playlist() {
  local sub="${1:-list}"; shift || true
  local name="" pl_file=""
  case "$sub" in
    list|"")
      echo "📂 Saved Playlists:"
      local count=0 pl tracks
      for pl in "$PLAYLISTS_DIR"/*.tsv; do
        [[ -f "$pl" ]] || continue
        tracks=$(grep -c . "$pl" 2>/dev/null || true)
        printf "  • %-24s (%d tracks)\n" "$(basename "$pl" .tsv)" "${tracks:-0}"
        count=$((count + 1))
      done
      if ((count == 0)); then echo "  (No playlists yet. Use: tunes playlist create <name>)"; fi
      ;;
    create)
      name="${1:-}"
      [[ -z "$name" ]] && read -rp "Playlist name: " name
      name=$(sanitize_name "$name"); [[ -z "$name" ]] && exit 0
      touch "$(playlist_path "$name")"
      echo "✔ Playlist created: $name"
      ;;
    add)
      name="${1:-}"; local query="${2:-}"
      [[ -z "$name" ]] && read -rp "Playlist name to add to: " name
      name=$(sanitize_name "$name"); [[ -z "$name" ]] && exit 0
      pl_file=$(playlist_path "$name"); touch "$pl_file"
      local selection title url
      if [[ "$query" == "--now" || "$query" == "now" ]]; then
        title=$(mpv_ipc '["get_property","media-title"]' 1 2>/dev/null) || { echo "Nothing is playing."; exit 1; }
        url=$(mpv_ipc '["get_property","path"]' 1 2>/dev/null) || { echo "Nothing is playing."; exit 1; }
      else
        if [[ -n "$query" ]]; then
          selection=$(search_and_pick "$query" | pick_from_list "Add to $name > ") || exit 0
        else
          selection=$(pick_from_list "Add from history > " < "$HISTORY_FILE") || exit 0
        fi
        [[ -z "$selection" ]] && exit 0
        title=$(cut -f1 <<<"$selection"); url=$(cut -f2 <<<"$selection")
      fi
      dedupe_tsv_by_url "$pl_file" "$url"
      printf '%s\t%s\n' "$(sanitize_field "$title")" "$url" >> "$pl_file"
      echo "✔ Added '$title' to playlist '$name'"
      desktop_notify "Playlist Updated" "Added to $name: $title" "audio-x-generic"
      ;;
    play)
      name="${1:-}"
      [[ -z "$name" ]] && { name=$(pick_playlist) || exit 0; }
      pl_file=$(playlist_path "$name")
      [[ -s "$pl_file" ]] || { echo "Playlist '$name' not found or empty."; exit 1; }
      play_queue "Playlist '$name'" "$(cat "$pl_file")"
      ;;
    view)
      name="${1:-}"
      [[ -z "$name" ]] && { name=$(pick_playlist) || exit 0; }
      pl_file=$(playlist_path "$name")
      [[ -s "$pl_file" ]] || { echo "Playlist '$name' is empty or does not exist."; exit 1; }
      echo "Tracks in '$name':"
      nl -ba -w2 -s'. ' <(cut -f1 "$pl_file")
      ;;
    remove)
      name="${1:-}"
      [[ -z "$name" ]] && { name=$(pick_playlist) || exit 0; }
      pl_file=$(playlist_path "$name")
      [[ -s "$pl_file" ]] || { echo "Playlist '$name' is empty or does not exist."; exit 1; }
      local sel
      sel=$(pick_from_list "🗑 Remove from $name > " < "$pl_file") || exit 0
      [[ -z "$sel" ]] && exit 0
      dedupe_tsv_by_url "$pl_file" "$(cut -f2 <<<"$sel")"
      echo "✔ Removed '$(cut -f1 <<<"$sel")' from '$name'"
      ;;
    delete)
      name="${1:-}"
      [[ -z "$name" ]] && { name=$(pick_playlist) || exit 0; }
      pl_file=$(playlist_path "$name")
      if [[ -f "$pl_file" ]]; then rm -f "$pl_file"; echo "✔ Deleted playlist: $name"
      else echo "Playlist '$name' not found."; fi
      ;;
    export) playlist_export "$@" ;;
    import) playlist_import "$@" ;;
    *)
      echo "Usage: tunes playlist {list|create|add|play|view|remove|delete|export|import} [name]"
      echo "       tunes playlist add <name> --now     (adds the track playing right now)"
      echo "       tunes playlist export <name> [file.m3u]   |   tunes playlist import <file.m3u> [name]"
      exit 1 ;;
  esac
}

# ---------- podcast playback ----------

play_podcast_url() {
  local title url feed_name extra=()
  title=$(sanitize_field "$1"); url="$2"; feed_name=$(sanitize_field "${3:-}")
  dedupe_tsv_by_url "$POD_HISTORY_FILE" "$url"
  { printf '%s\t%s\t%s\n' "$title" "$url" "$feed_name"; cat "$POD_HISTORY_FILE" 2>/dev/null || true; } > "$POD_HISTORY_FILE.tmp"
  head -n 300 "$POD_HISTORY_FILE.tmp" > "$POD_HISTORY_FILE"
  rm -f "$POD_HISTORY_FILE.tmp"
  [[ "${LOOP:-0}" == "1" ]] && extra+=(--loop-file=inf)
  launch_mpv podcast "Podcast: $title" --no-video --force-media-title="$title" \
    --save-position-on-quit "${extra[@]}" "$url"
}

# ---------- natural language / mood search (local LLM) ----------

cmd_mood() {
  local desc="${1:-}"
  [[ -z "$desc" ]] && read -rp "Describe what you want to listen to: " desc
  [[ -z "$desc" ]] && exit 0

  if ! llm_available; then
    echo "⚠ No local LLM reachable at ${LLM_URL} — using a plain search for: $desc"
    echo "  (connect one with: tunes ai setup)"
    cmd_search "$desc"
    return 0
  fi

  echo "Thinking about: \"$desc\" ..." >&2
  local sys="You turn a mood or vibe description into good YouTube search queries for music. Reply with ONLY 5 short search queries, one per line, no numbering, no explanation, no quotes."
  local raw queries
  raw=$(llm_ask "$sys" "$desc" 2>/dev/null) || raw=""
  queries=$(echo "$raw" | llm_lines_to_list 5 || true)
  if [[ -z "$queries" ]]; then
    echo "The model gave no usable output — using a plain search instead."
    cmd_search "$desc"
    return 0
  fi

  echo "Searching for:"
  echo "$queries" | sed 's/^/  • /'
  local combined="" q
  while IFS= read -r q; do
    [[ -z "$q" ]] && continue
    combined+="$(search_and_pick "$q" 6 || true)"$'\n'
  done <<< "$queries"
  combined=$(printf '%s' "$combined" | awk -F'\t' 'NF >= 2 && !seen[$2]++')
  [[ -z "$combined" ]] && { echo "No results found."; exit 0; }

  local selections
  selections=$(printf '%s\n' "$combined" | pick_multi "🎵 mood: $desc (tab to multi-select) > ") || exit 0
  [[ -z "$selections" ]] && exit 0
  play_queue "Mood: $desc" "$selections"
}


