  selection=$(search_and_pick "$query" | pick_from_list "🎵 > ") || { echo "Cancelled."; exit 0; }
  [[ -z "$selection" ]] && exit 0
  play_url "$(cut -f1 <<<"$selection")" "$(cut -f2 <<<"$selection")"
}

cmd_queue() {
  local query="${1:-}"
  [[ -z "$query" ]] && read -rp "Search (queue mode): " query
  [[ -z "$query" ]] && exit 0
  local selections
  selections=$(search_and_pick "$query" | pick_multi "🎵 select multiple (tab) > ") || exit 0
  [[ -z "$selections" ]] && exit 0
  play_queue "Queue" "$selections"
}

cmd_video() {
  local query="${1:-}"
  [[ -z "$query" ]] && read -rp "Search (video): " query
  [[ -z "$query" ]] && exit 0
  local selection
  selection=$(search_and_pick "$query" | pick_from_list "🎬 > ") || { echo "Cancelled."; exit 0; }
  [[ -z "$selection" ]] && exit 0
  local title url clean extra=()
  title=$(cut -f1 <<<"$selection"); url=$(cut -f2 <<<"$selection")
