# ---------- dispatch ----------

LOOP=0
SHUFFLE=0
DETACH=0

while [[ "${1:-}" == -* ]]; do
  case "$1" in
    -l|--loop) LOOP=1; shift ;;
    -s|--shuffle) SHUFFLE=1; shift ;;
    -d|--bg|--detach) DETACH=1; shift ;;
    -h|--help) cmd_help; exit 0 ;;
    *) break ;;
  esac
done
export LOOP SHUFFLE DETACH

cmd="${1:-help}"; shift || true
case "$cmd" in
  search)        cmd_search "${1:-}";;
  bg)            DETACH=1; cmd_search "${1:-}";;
  play)          cmd_play "${1:-}";;
  video)         cmd_video "${1:-}";;
  vlc)           cmd_vlc "${1:-}";;
  queue)         cmd_queue "${1:-}";;
  history)       cmd_history;;
  fav-add)       cmd_favorite_add;;
  favorites)     cmd_favorites;;
  fav-remove)    cmd_favorite_remove;;
  download)      cmd_download "${1:-}";;
  lyrics)        cmd_lyrics;;
  status|np)     cmd_status;;
  notify)        cmd_notify;;
  ctl)           cmd_ctl "${1:-}" "${2:-}";;
  playlist)      cmd_playlist "${@:-}";;
  pod-add)       cmd_podcast_add "${1:-}";;
  pod-add-url)   cmd_podcast_add_url "${1:-}" "${2:-}";;
  pod-remove)    cmd_podcast_remove;;
  pod-feeds)     cmd_podcast_feeds;;
  pod)           cmd_podcast_play;;
  pod-history)   cmd_podcast_history;;
  pod-download)  cmd_podcast_download;;
  recommend)     cmd_recommend "${1:-}";;
  mood)          cmd_mood "${1:-}";;
  stats)         cmd_stats;;
  completion)    cmd_completion;;
  help|-h|--help|*) cmd_help;;
esac
