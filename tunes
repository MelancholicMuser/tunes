  [[ -z "$selection" ]] && exit 0
  local title url
  title=$(cut -f1 <<<"$selection")
  url=$(cut -f2 <<<"$selection")
  command -v ffmpeg >/dev/null 2>&1 || { echo "Audio downloads need ffmpeg ($(install_hint ffmpeg))"; exit 1; }
  mkdir -p "$DOWNLOAD_DIR"
  echo "⬇ Downloading to $DOWNLOAD_DIR (Format: ${DOWNLOAD_FORMAT:-best}) ..."
  desktop_notify "Downloading Track" "$title" "emblem-downloads"

  local dl_opts=(-x --embed-thumbnail --add-metadata)
  case "${DOWNLOAD_FORMAT:-best}" in
    best)
      # Native stream format (Opus/m4a) — bit-perfect without generational loss
      ;;
    flac)
      dl_opts+=(--audio-format flac)
      ;;
    opus)
      dl_opts+=(--audio-format opus)
      ;;
    mp3)
      dl_opts+=(--audio-format mp3 --audio-quality 0)
      ;;
    *)
      dl_opts+=(--audio-format "$DOWNLOAD_FORMAT")
      ;;
  esac

  yt-dlp "${dl_opts[@]}" -o "${DOWNLOAD_DIR}/%(title)s.%(ext)s" "$url"
  echo "✔ Download complete: $DOWNLOAD_DIR"
  desktop_notify "Download Complete" "$title" "emblem-default"
