STATS_PY=''
read -r -d '' STATS_PY <<'PYEOF' || true
import sys, os, re, json, shutil, argparse, random
from collections import Counter
from datetime import datetime, timedelta

YT_RE = re.compile(r'(?:[?&]v=|youtu\.be/|/shorts/|/embed/)([A-Za-z0-9_-]{11})')
WEEKDAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
PARTS = [('night', 0, 6), ('morning', 6, 12), ('afternoon', 12, 18), ('evening', 18, 24)]
SPARK = ' ▁▂▃▄▅▆▇█'
TAIL_W = 15


# ---------------------------------------------------------------- loading
def key_of(url):
    m = YT_RE.search(url or '')
    return 'yt:' + m.group(1) if m else (url or '')


def clean_artist(a):
    return re.sub(r'\s*-\s*Topic$', '', (a or '').strip(), flags=re.I)


def load(path, thresh):
    rows = []
    try:
        f = open(path, encoding='utf-8', errors='replace')
    except OSError:
        return rows
    with f:
        for line in f:
            p = line.rstrip('\n').split('\t')
            if len(p) < 7:
                continue
            try:
                ts, listened, dur = int(float(p[0])), float(p[2]), float(p[3] or 0)
            except ValueError:
                continue
            kind = p[1] or 'music'
            need = 60.0 if kind == 'podcast' else float(thresh)
            if dur > 0:
                need = min(need, dur * 0.5)
            rows.append(dict(ts=ts, kind=kind, listened=listened, dur=dur, title=p[4],
                             artist=clean_artist(p[5]), url=p[6], key=key_of(p[6]),
                             counted=listened >= need))
    rows.sort(key=lambda r: r['ts'])
    return rows


# ---------------------------------------------------------------- periods
def parse_period(s, now):
    """-> (start_ts|None, end_ts, label)"""
    s = (s or 'week').strip().lower()
    end = int(now.timestamp())
    if s in ('all', 'alltime', 'all-time', 'ever'):
        return None, end, 'all time'
    if s == 'today':
        mid = now.replace(hour=0, minute=0, second=0, microsecond=0)
        return int(mid.timestamp()), end, 'today'
    if s == 'yesterday':
        mid = now.replace(hour=0, minute=0, second=0, microsecond=0)
        return int((mid - timedelta(days=1)).timestamp()), int(mid.timestamp()), 'yesterday'
    named = {'week': 7, 'weekly': 7, 'month': 30, 'monthly': 30, 'year': 365, 'yearly': 365}
    days = named.get(s)
    if days is None:
        m = re.fullmatch(r'(\d+)\s*([dwmy]?)', s)
        if m:
            mult = {'': 1, 'd': 1, 'w': 7, 'm': 30, 'y': 365}[m.group(2)]
            days = int(m.group(1)) * mult
    if days:
        return end - days * 86400, end, 'last %d days' % days if days != 7 else 'last 7 days'
    if re.fullmatch(r'\d{4}-\d{2}-\d{2}', s):
        d = datetime.strptime(s, '%Y-%m-%d')
        return int(d.timestamp()), end, 'since ' + s
    if re.fullmatch(r'\d{4}-\d{2}', s):
        d = datetime.strptime(s, '%Y-%m')
        nxt = (d.replace(day=28) + timedelta(days=4)).replace(day=1)
        return int(d.timestamp()), int(nxt.timestamp()), d.strftime('%B %Y')
    raise SystemExit("Unknown period '%s'. Try: today, week, month, year, all, 14d, 8w, 2026-10-01, 2026-09" % s)


# ---------------------------------------------------------------- analysis
def streaks(dates, today):
    if not dates:
        return 0, 0
    ds = sorted(dates)
    longest = run = 1
    for a, b in zip(ds, ds[1:]):
        run = run + 1 if (b - a).days == 1 else 1
        longest = max(longest, run)
    cur, d = 0, today
    if d not in dates:
        d = today - timedelta(days=1)
    while d in dates:
        cur += 1
        d -= timedelta(days=1)
    return cur, longest


def window(rows, start, end):
    return [r for r in rows if (start is None or r['ts'] >= start) and r['ts'] < end]


def basics(sel):
    played = [r for r in sel if r['counted']]
    return dict(plays=len(played), skips=len(sel) - len(played),
                secs=sum(r['listened'] for r in sel),
                unique_tracks=len({r['key'] for r in played}))


def analyze(rows, start, end, label, now):
    music = [r for r in rows if r['kind'] != 'podcast']
    pods = [r for r in rows if r['kind'] == 'podcast']
    first_seen = {}
    for r in music:
        if r['counted'] and r['key'] not in first_seen:
            first_seen[r['key']] = r['ts']

    sel = window(music, start, end)
    played = [r for r in sel if r['counted']]
    tracks = {}
    for r in sel:  # chronological, so the newest title/url wins
        t = tracks.setdefault(r['key'], dict(key=r['key'], plays=0, skips=0, secs=0.0, last=0,
                                             title='', artist='', url=''))
        t.update(title=r['title'] or t['title'], artist=r['artist'] or t['artist'], url=r['url'], last=r['ts'])
        t['secs'] += r['listened']
        t['plays' if r['counted'] else 'skips'] += 1
    ranked = sorted((t for t in tracks.values() if t['plays']),
                    key=lambda t: (-t['plays'], -t['secs'], -t['last']))
    skipped = sorted((t for t in tracks.values() if t['skips'] >= 2 and t['skips'] > t['plays']),
                     key=lambda t: (-t['skips'], t['title']))

    artists = {}
    for r in played:
        if not r['artist']:
            continue
        a = artists.setdefault(r['artist'], dict(artist=r['artist'], plays=0, secs=0.0, keys=set()))
        a['plays'] += 1
        a['secs'] += r['listened']
        a['keys'].add(r['key'])
    top_artists = sorted(artists.values(), key=lambda a: (-a['plays'], -a['secs']))
    for a in top_artists:
        a['tracks'] = len(a.pop('keys'))

    weekday, hours = [0] * 7, [0] * 24
    day_counts = Counter()
    for r in played:
        dt = datetime.fromtimestamp(r['ts'])
        weekday[dt.weekday()] += 1
        hours[dt.hour] += 1
        day_counts[dt.date()] += 1
    parts = {name: sum(hours[a:b]) for name, a, b in PARTS}

    all_days = {datetime.fromtimestamp(r['ts']).date() for r in music if r['counted']}
    cur_streak, best_streak = streaks(all_days, now.date())

    new_keys = {k for k, ts in first_seen.items()
                if (start is None or ts >= start) and ts < end}
    played_keys = {r['key'] for r in played}
    new_top = [t for t in ranked if t['key'] in new_keys][:3]

    prev = None
    if start is not None:
        span = end - start
        prev = basics(window(music, start - span, start))

    pod_sel = window(pods, start, end)
    d = dict(label=label, start=start, end=end, **basics(sel))
    d.update(
        starts=len(sel),
        skip_rate=(len(sel) - len(played)) / len(sel) if sel else 0.0,
        unique_artists=len(artists),
        top_tracks=ranked, top_artists=top_artists, most_skipped=skipped[:3],
        weekday=weekday, hours=hours, parts=parts,
        busiest_day=(max(day_counts.items(), key=lambda kv: (kv[1], kv[0])) if day_counts else None),
        active_days=len(day_counts),
        streak_current=cur_streak, streak_longest=best_streak,
        new_tracks=len(new_keys & played_keys), familiar_tracks=len(played_keys - new_keys),
        new_top=new_top, prev=prev,
        podcast_secs=sum(r['listened'] for r in pod_sel),
        podcast_episodes=len({r['key'] for r in pod_sel if r['counted']}),
        first_play=(datetime.fromtimestamp(music[0]['ts']).date() if music else None),
    )
    return d


# ---------------------------------------------------------------- formatting
def fmt_dur(s):
    s = int(round(s))
    h, rem = divmod(s, 3600)
    m = rem // 60
    if h:
        return '%dh %02dm' % (h, m)
    return '%dm' % m if m else '%ds' % s


def fmt_clock(s):
    m, sec = divmod(int(s), 60)
    return '%d:%02d' % (m, sec)


def n(count, word):
    return '%d %s%s' % (count, word, '' if count == 1 else 's')


def pct(a, b):
    if not b:
        return 'new' if a else '—'
    v = round((a - b) / b * 100)
    return '%+d%%' % v


def bar(v, vmax, width=18):
    if not vmax or not v:
        return ''
    return '█' * max(1, round(v / vmax * width))


def spark(values):
    vmax = max(values) if values else 0
    if not vmax:
        return SPARK[0] * len(values)
    return ''.join(SPARK[max(1, round(v / vmax * 8))] if v else SPARK[0] for v in values)


def clip(s, n):
    return s if len(s) <= n else s[:max(1, n - 1)] + '…'


def span_text(d):
    if d['start'] is None:
        return ''
    a = datetime.fromtimestamp(d['start'])
    b = datetime.fromtimestamp(d['end'])
    return '%s → %s' % (a.strftime('%b %d'), b.strftime('%b %d, %Y'))


class Out:
    def __init__(self, color):
        self.color, self.lines = color, []

    def c(self, code, s):
        return '\033[%sm%s\033[0m' % (code, s) if self.color else s

    def add(self, s=''):
        self.lines.append(s)

    def text(self):
        return '\n'.join(self.lines)


def track_line(o, i, t, width):
    name = t['title'] + (' — ' + t['artist'] if t['artist'] and t['artist'].lower() not in t['title'].lower() else '')
    tail = ('×%d · %s' % (t['plays'], fmt_dur(t['secs']))).rjust(TAIL_W)
    room = max(20, width - TAIL_W - 8)
    return ' %s %s  %s' % (o.c('2', '%2d.' % i), clip(name, room).ljust(room), o.c('36', tail))


def render(d, color, mode):
    o, W = Out(color), min(shutil.get_terminal_size((90, 24)).columns, 100)
    title = 'Tunes Weekly Report' if (mode == 'report' and d['label'] == 'last 7 days') else \
            ('Tunes Listening Report' if mode == 'report' else 'Tunes Listening Statistics')
    o.add(o.c('1', '🎧 ' + title) + '  ' + o.c('2', d['label'] + (('  ·  ' + span_text(d)) if span_text(d) else '')))
    o.add('')
    if not d['starts'] and not d['podcast_secs']:
        o.add('  No listening logged in this period yet.')
        o.add('  Plays are tracked automatically while you listen with tunes (a play counts after %ss).' %
              os.environ.get('TUNES_THRESH', '30'))
        return o.text()

    o.add(' ▸ %s plays · %s listened · %d unique tracks · %d artists' % (
        o.c('1', '{:,}'.format(d['plays'])), o.c('1', fmt_dur(d['secs'])), d['unique_tracks'], d['unique_artists']))
    if d['starts']:
        o.add(' ▸ Skip rate %d%% (%d of %d starts)' % (round(d['skip_rate'] * 100), d['skips'], d['starts']))
    if d['prev'] is not None and (d['prev']['plays'] or d['prev']['secs']):
        o.add(' ▸ vs previous period: plays %s · time %s' % (
            o.c('32', pct(d['plays'], d['prev']['plays'])), o.c('32', pct(d['secs'], d['prev']['secs']))))
    if d['streak_current'] or d['streak_longest']:
        o.add(' ▸ Streak: %d day%s (best: %d)' % (d['streak_current'], '' if d['streak_current'] == 1 else 's', d['streak_longest']))
    if mode == 'stats' and d['first_play']:
        o.add(' ▸ Listening since %s' % d['first_play'])
    o.add('')

    n_tracks = 10 if mode == 'stats' else 8
    if d['top_tracks']:
        o.add(o.c('1;33', '🔥 Most played'))
        for i, t in enumerate(d['top_tracks'][:n_tracks], 1):
            o.add(track_line(o, i, t, W))
        o.add('')
    if d['top_artists']:
        o.add(o.c('1;35', '🎤 Top artists'))
        for i, a in enumerate(d['top_artists'][:5], 1):
            tail = ('×%d · %d track%s' % (a['plays'], a['tracks'], '' if a['tracks'] == 1 else 's')).rjust(TAIL_W)
            room = max(20, W - TAIL_W - 8)
            o.add(' %s %s  %s' % (o.c('2', '%2d.' % i), clip(a['artist'], room).ljust(room), o.c('36', tail)))
        o.add('')

    if mode == 'report':
        if d['plays']:
            vmax = max(d['weekday'])
            o.add(o.c('1;34', '📅 By weekday'))
            for name, v in zip(WEEKDAYS, d['weekday']):
                o.add('  %s %s %s' % (name, o.c('34', bar(v, vmax).ljust(18)), v if v else ''))
            o.add('')
            peak = max(range(24), key=lambda h: (d['hours'][h], -h))
            top_part = max(d['parts'].items(), key=lambda kv: kv[1])[0]
            o.add(o.c('1;34', '🕒 Time of day'))
            o.add('  0h %s 23h' % spark(d['hours']))
            o.add('  Mostly %s listening · peak hour %02d:00 (%d plays)' % (top_part, peak, d['hours'][peak]))
            if d['busiest_day']:
                o.add('  Busiest day: %s (%d plays)' % (d['busiest_day'][0].strftime('%a %b %d'), d['busiest_day'][1]))
            o.add('')
            o.add(o.c('1;32', '✨ Discovery'))
            o.add('  %d new track%s this period · %d familiar favourites' % (
                d['new_tracks'], '' if d['new_tracks'] == 1 else 's', d['familiar_tracks']))
            for t in d['new_top']:
                o.add('    + %s' % clip(t['title'] + (' — ' + t['artist'] if t['artist'] else ''), W - 8))
            o.add('')
        if d['most_skipped']:
            o.add(o.c('1;31', '⏭ Often skipped'))
            for t in d['most_skipped']:
                o.add('  %s  (%d skips)' % (clip(t['title'], W - 20), t['skips']))
            o.add('')
    if d['podcast_secs'] >= 60:
        o.add(o.c('1', '🎙 Podcasts') + ': %s across %d episode%s' % (
            fmt_dur(d['podcast_secs']), d['podcast_episodes'], '' if d['podcast_episodes'] == 1 else 's'))
        o.add('')
    return o.text().rstrip('\n')


def context(d):
    """Compact plain-text digest for an LLM: numbers only, nothing to invent."""
    L = []
    L.append('Period: %s%s' % (d['label'], (' (%s)' % span_text(d)) if span_text(d) else ''))
    pv = d['prev']
    L.append('Plays: %d%s' % (d['plays'], (' (previous period: %d, change %s)' % (pv['plays'], pct(d['plays'], pv['plays']))) if pv else ''))
    L.append('Listening time: %s%s' % (fmt_dur(d['secs']), (' (previous: %s)' % fmt_dur(pv['secs'])) if pv else ''))
    L.append('Unique tracks: %d; unique artists: %d' % (d['unique_tracks'], d['unique_artists']))
    L.append('Skip rate: %d%% (%d skips of %d starts)' % (round(d['skip_rate'] * 100), d['skips'], d['starts']))
    if d['top_tracks']:
        L.append('Top tracks: ' + '; '.join('%d. "%s"%s - %s' % (
            i, t['title'], (' by ' + t['artist']) if t['artist'] else '', n(t['plays'], 'play'))
            for i, t in enumerate(d['top_tracks'][:10], 1)))
    if d['top_artists']:
        L.append('Top artists: ' + '; '.join('%s (%s, %s)' % (a['artist'], n(a['plays'], 'play'), n(a['tracks'], 'track'))
                                              for a in d['top_artists'][:6]))
    L.append('Plays by weekday: ' + ', '.join('%s %d' % kv for kv in zip(WEEKDAYS, d['weekday'])))
    L.append('Plays by time of day: ' + ', '.join('%s %d' % kv for kv in d['parts'].items()))
    if d['busiest_day']:
        L.append('Busiest day: %s with %s' % (d['busiest_day'][0], n(d['busiest_day'][1], 'play')))
    L.append('New tracks first heard this period: %d; familiar tracks replayed: %d' % (d['new_tracks'], d['familiar_tracks']))
    if d['new_top']:
        L.append('Most played new tracks: ' + '; '.join('"%s"' % t['title'] for t in d['new_top']))
    if d['most_skipped']:
        L.append('Often skipped: ' + '; '.join('"%s" (%s)' % (t['title'], n(t['skips'], 'skip')) for t in d['most_skipped']))
    L.append('Current listening streak: %s (best ever: %d)' % (n(d['streak_current'], 'day'), d['streak_longest']))
    if d['podcast_secs'] >= 60:
        L.append('Podcast time: %s over %s' % (fmt_dur(d['podcast_secs']), n(d['podcast_episodes'], 'episode')))
    return '\n'.join(L)


def jsonable(d):
    def conv(x):
        if isinstance(x, (datetime,)) or hasattr(x, 'isoformat'):
            return x.isoformat()
        if isinstance(x, set):
            return sorted(x)
        return str(x)
    return json.dumps(d, default=conv, ensure_ascii=False, indent=2)


# ---------------------------------------------------------------- main
def main():
    ap = argparse.ArgumentParser(prog='tunes-stats')
    ap.add_argument('mode', choices=['stats', 'report', 'top', 'context', 'json', 'count'])
    ap.add_argument('plays_file')
    ap.add_argument('--period', default=None)
    ap.add_argument('--limit', type=int, default=100)
    ap.add_argument('--thresh', type=float, default=float(os.environ.get('TUNES_THRESH', '30')))
    ap.add_argument('--color', action='store_true')
    a = ap.parse_args()

    now = datetime.now()
    default_period = 'all' if a.mode in ('stats', 'top') else 'week'
    start, end, label = parse_period(a.period or default_period, now)
    rows = load(a.plays_file, a.thresh)
    d = analyze(rows, start, end, label, now)

    if a.mode == 'count':
        print(d['plays'])
    elif a.mode == 'top':
        for t in d['top_tracks'][:a.limit]:
            print('\t'.join([t['title'], t['url'], t['artist'], '×%d · %s' % (t['plays'], fmt_clock(t['secs']))]))
    elif a.mode == 'context':
        print(context(d))
    elif a.mode == 'json':
        print(jsonable(d))
    else:
        print(render(d, a.color, a.mode))


if __name__ == '__main__':
    try:
        main()
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        os._exit(0)
