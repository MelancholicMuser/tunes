# ---------- timers: sleep & alarm ----------

SLEEP_PID_FILE="$RUNTIME_BASE/tunes-sleep-${UID:-$(id -u)}.pid"   # "<pid> <end-epoch>"
ALARM_PID_FILE="$RUNTIME_BASE/tunes-alarm-${UID:-$(id -u)}.pid"

# parse_duration 45 | 45m | 1h30m | 90s  ->  seconds (a bare number means minutes)
parse_duration() {
  local s="${1,,}" total=0 num unit
  [[ -n "$s" ]] || return 1
  if [[ "$s" =~ ^[0-9]+$ ]]; then total=$((10#$s * 60)); ((total > 0)) || return 1; echo "$total"; return 0; fi
  [[ "$s" =~ ^([0-9]+[hms])+$ ]] || return 1
  while [[ -n "$s" ]]; do
    [[ "$s" =~ ^([0-9]+)([hms])(.*)$ ]] || return 1
    num="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[2]}"; s="${BASH_REMATCH[3]}"
    case "$unit" in
      h) total=$((total + 10#$num * 3600)) ;;
      m) total=$((total + 10#$num * 60)) ;;
      s) total=$((total + 10#$num)) ;;
    esac
  done
  ((total > 0)) || return 1
  echo "$total"
}

fmt_secs() {
  local s="$1"
  if ((s >= 3600)); then printf '%dh %02dm' $((s / 3600)) $((s % 3600 / 60))
  elif ((s >= 60)); then printf '%dm %02ds' $((s / 60)) $((s % 60))
  else printf '%ds' "$s"; fi
}

# live_timer <pidfile> -> prints "<pid> <end-epoch>" when that helper is still running
live_timer() {
  local f="$1" pid="" end=""
  [[ -f "$f" ]] || return 1
  read -r pid end < "$f" || true
  if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
    printf '%s %s' "$pid" "${end:-0}"
    return 0
  fi
  rm -f "$f"
  return 1
}

cancel_timer() {
  local f="$1" info pid
  info=$(live_timer "$f") || return 1
  pid="${info%% *}"
  pkill -P "$pid" 2>/dev/null || true
  kill "$pid" 2>/dev/null || true
  rm -f "$f"
  return 0
}

start_timer() {   # start_timer <pidfile> <secs> <internal-command> [args...]
  local f="$1" secs="$2" pid; shift 2
  cancel_timer "$f" || true
  nohup bash "$SELF" "$@" </dev/null >/dev/null 2>&1 &
  pid=$!
  disown "$pid"
  printf '%s %s\n' "$pid" "$(( $(date +%s) + secs ))" > "$f"
}

# Internal: fades the volume out over the last seconds, then stops playback.
__sleep_run() {
  local secs="$1" fade=15 vol i
  if ((secs > fade)); then sleep $((secs - fade)); else fade="$secs"; fi
  if mpv_ipc '["get_property","pid"]' 0 >/dev/null 2>&1; then
    vol=$(mpv_ipc '["get_property","volume"]' 1 2>/dev/null || echo 100)
    vol="${vol%.*}"; [[ "$vol" =~ ^[0-9]+$ ]] || vol=100
    for ((i = fade - 1; i >= 0; i--)); do
      mpv_ipc "[\"set_property\",\"volume\",$((vol * i / fade))]" 0 >/dev/null 2>&1 || break
      sleep 1
    done
    mpv_ipc '["quit"]' 0 >/dev/null 2>&1 || true
    rm -f "$MPV_SOCKET"
    desktop_notify "Tunes" "Sleep timer: playback stopped" "media-playback-stop"
  fi
  rm -f "$SLEEP_PID_FILE"
}

# tunes sleep <30m|1h30m|90s|45> | status | off
cmd_sleep() {
  local arg="${1:-status}" info secs
  case "$arg" in
    status)
      if info=$(live_timer "$SLEEP_PID_FILE"); then
        secs=$(( ${info#* } - $(date +%s) )); ((secs < 0)) && secs=0
        echo "😴 Sleep timer: playback stops in $(fmt_secs "$secs")   (cancel: tunes sleep off)"
      else
        echo "No sleep timer set.   Usage: tunes sleep 30m"
      fi ;;
    off|cancel|stop)
      if cancel_timer "$SLEEP_PID_FILE"; then echo "✔ Sleep timer cancelled"; else echo "No sleep timer set."; fi ;;
    *)
      secs=$(parse_duration "$arg") || { echo "Usage: tunes sleep <30m | 1h30m | 90s | 45 (minutes)> | status | off" >&2; return 1; }
      start_timer "$SLEEP_PID_FILE" "$secs" __sleep_run "$secs"
      echo "😴 Sleep timer set: music fades out and stops in $(fmt_secs "$secs")" ;;
  esac
}

# Internal: waits, then starts the alarm playlist (or your mix) in the background.
__alarm_run() {
  local secs="$1" what="${2:-}"
  sleep "$secs"
  rm -f "$ALARM_PID_FILE"
  desktop_notify "Tunes" "⏰ Good morning — starting your music" "alarm-clock"
  if [[ -n "$what" && "$what" != "mix" ]]; then bash "$SELF" -d playlist play "$what" || true
  else bash "$SELF" -d mix || true; fi
}

# tunes alarm <HH:MM> [playlist|mix] | status | off
cmd_alarm() {
  local arg="${1:-status}" what="${2:-mix}" info secs now target
  case "$arg" in
    status)
      if info=$(live_timer "$ALARM_PID_FILE"); then
        secs=$(( ${info#* } - $(date +%s) )); ((secs < 0)) && secs=0
        echo "⏰ Alarm rings in $(fmt_secs "$secs")   (cancel: tunes alarm off)"
      else
        echo "No alarm set.   Usage: tunes alarm 07:30 [playlist]"
      fi ;;
    off|cancel|stop)
      if cancel_timer "$ALARM_PID_FILE"; then echo "✔ Alarm cancelled"; else echo "No alarm set."; fi ;;
    *)
      if ! [[ "$arg" =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ ]]; then
        echo "Usage: tunes alarm <HH:MM> [playlist|mix] | status | off" >&2; return 1
      fi
      if [[ "$what" != "mix" && ! -s "$(playlist_path "$what")" ]]; then
        echo "Playlist '$what' not found or empty (use a playlist name, or 'mix')." >&2; return 1
      fi
      now=$(date +%s)
      target=$(date -d "$arg" +%s 2>/dev/null) || { echo "Could not understand the time '$arg'." >&2; return 1; }
      ((target > now)) || target=$(date -d "tomorrow $arg" +%s)
      secs=$((target - now))
      start_timer "$ALARM_PID_FILE" "$secs" __alarm_run "$secs" "$what"
      echo "⏰ Alarm set for $(date -d "@$target" '+%a %H:%M') ($(fmt_secs "$secs") from now) → ${what}"
      echo "   (keep this machine awake until then; it only runs while your session is up)" ;;
  esac
}

# ---------- smart playlists from your stats ----------

# save_rows_as_playlist <name> <tsv rows: title \t url ...>
save_rows_as_playlist() {
  local name pl_file n=0 title url rest
  name=$(sanitize_name "$1")
  [[ -n "$name" ]] || { echo "Playlist name is empty." >&2; return 1; }
  pl_file=$(playlist_path "$name"); touch "$pl_file"
  while IFS=$'\t' read -r title url rest; do
    [[ -n "$url" ]] || continue
    dedupe_tsv_by_url "$pl_file" "$url"
    printf '%s\t%s\n' "$(sanitize_field "$title")" "$url" >> "$pl_file"
    n=$((n + 1))
  done <<< "$2"
  echo "✔ Saved $n tracks to playlist '$name'   (play it: tunes playlist play \"$name\")"
}

# play_stats_rows <queue label> <fzf prompt> <rows from stats_engine top>
play_stats_rows() {
  local label="$1" prompt="$2" rows="$3" selections
  selections=$(printf '%s\n' "$rows" | fzf --multi --delimiter='\t' --with-nth=1,3,4 \
      --prompt="$prompt" --header="TAB: select several · ENTER: play · ?: details" \
      --height=70% --border --reverse \
      --preview='echo -e "Title:   \033[1m{1}\033[0m\nArtist:  {3}\nPlays:   {4}\nURL:     {2}"' \
      --preview-window="down:4:wrap:hidden" --bind="?:toggle-preview") || exit 0
  [[ -z "$selections" ]] && exit 0
  play_queue "$label" "$selections"
}

# tunes forgotten [days] [--min-plays N] [--save NAME]
#   tracks you played a lot once, but not in the last N days (default 90)
cmd_forgotten() {
  local days=90 min=3 save="" all recent rows
  while (($#)); do
    case "$1" in
      --save) save="${2:-}"; [[ -n "$save" ]] || { echo "Usage: tunes forgotten [days] [--min-plays N] [--save NAME]" >&2; return 1; }; shift 2 ;;
      --min-plays) min="${2:-}"; [[ "$min" =~ ^[0-9]+$ ]] || { echo "--min-plays needs a number" >&2; return 1; }; shift 2 ;;
      *) if [[ "${1%d}" =~ ^[0-9]+$ ]] && ((10#${1%d} > 0)); then days="${1%d}"; shift
         else echo "Usage: tunes forgotten [days] [--min-plays N] [--save NAME]" >&2; return 1; fi ;;
    esac
  done
  all=$(stats_engine top --period all --limit 100000)
  recent=$(stats_engine top --period "${days}d" --limit 100000 | cut -f2)
  rows=$(awk -F'\t' -v min="$min" '
    NR == FNR { seen[$0] = 1; next }
    !($2 in seen) { n = $4; sub(/^×/, "", n); sub(/ .*/, "", n); if (n + 0 >= min) print }
  ' <(printf '%s\n' "$recent") <(printf '%s\n' "$all"))
  if [[ -z "$rows" ]]; then
    echo "Nothing forgotten: no track with ≥$min plays has been missing for $days days."; return 0
  fi
  if [[ -n "$save" ]]; then save_rows_as_playlist "$save" "$(cut -f1,2 <<<"$rows")"; return 0; fi
  play_stats_rows "Forgotten favourites (>${days}d)" "💤 forgotten (>${days}d) > " "$rows"
}

# ---------- playlist import / export (M3U) ----------

playlist_export() {
  local name="${1:-}" out="${2:-}" pl_file title url
  [[ -z "$name" ]] && { name=$(pick_playlist) || exit 0; }
  pl_file=$(playlist_path "$name")
  [[ -s "$pl_file" ]] || { echo "Playlist '$name' is empty or does not exist."; exit 1; }
  [[ -z "$out" ]] && out="./$(sanitize_name "$name").m3u"
  {
    printf '#EXTM3U\n'
    while IFS=$'\t' read -r title url _; do
      [[ -n "$url" ]] || continue
      printf '#EXTINF:-1,%s\n%s\n' "$title" "$url"
    done < "$pl_file"
  } > "$out"
  echo "✔ Exported $(grep -c '^#EXTINF' "$out") tracks to $out"
}

# Reads .m3u / .m3u8 (with or without #EXTINF titles) or a plain list of URLs, one per line.
playlist_import() {
  local src="${1:-}" name="${2:-}" pl_file line pending="" url title n=0 base
  [[ -f "$src" ]] || { echo "Usage: tunes playlist import <file.m3u|file.m3u8|list.txt> [name]" >&2; exit 1; }
  [[ -z "$name" ]] && name=$(basename "${src%.*}")
  name=$(sanitize_name "$name"); [[ -n "$name" ]] || exit 1
  pl_file=$(playlist_path "$name"); touch "$pl_file"
  base="$(cd "$(dirname "$src")" && pwd)"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ -z "${line// }" ]] && continue
    if [[ "$line" == '#EXTINF:'* ]]; then pending="${line#*,}"; continue; fi
    [[ "$line" == '#'* ]] && continue
    url="$line"
    if [[ ! "$url" =~ ^[A-Za-z][A-Za-z0-9+.-]*:// && "$url" != /* ]]; then url="$base/$url"; fi
    title="${pending:-$(basename "${url%%\?*}")}"; pending=""
    dedupe_tsv_by_url "$pl_file" "$url"
    printf '%s\t%s\n' "$(sanitize_field "$title")" "$url" >> "$pl_file"
    n=$((n + 1))
  done < "$src"
  echo "✔ Imported $n tracks into playlist '$name'"
}

# ---------- ListenBrainz scrobbling ----------

SCROBBLE_PY=$(cat <<'PYEOF'
import sys, json, os, re
path, cursor = sys.argv[1], int(sys.argv[2])
thresh = float(os.environ.get('TUNES_THRESH', '30'))
BATCH = 100
rows = []
try:
    f = open(path, encoding='utf-8', errors='replace')
except OSError:
    sys.exit(0)
with f:
    for line in f:
        p = line.rstrip('\n').split('\t')
        if len(p) < 7:
            continue
        try:
            ts, listened, dur = int(float(p[0])), float(p[2]), float(p[3] or 0)
        except ValueError:
            continue
        if (p[1] or 'music') != 'music' or ts <= cursor:
            continue
        need = min(thresh, dur * 0.5) if dur > 0 else thresh      # same rule as the stats engine
        title = p[4].strip()
        artist = re.sub(r'\s*-\s*Topic$', '', p[5].strip())
        if listened < need or not title or not artist:
            continue
        info = {'media_player': 'tunes', 'submission_client': 'tunes',
                'submission_client_version': os.environ.get('TUNES_VERSION', '')}
        if re.match(r'^https?://', p[6]):
            info['origin_url'] = p[6]
        if dur > 0:
            info['duration'] = int(dur)
        rows.append((ts, {'listened_at': ts, 'track_metadata': {
            'artist_name': artist, 'track_name': title, 'additional_info': info}}))
rows.sort(key=lambda r: r[0])
for i in range(0, len(rows), BATCH):
    chunk = rows[i:i + BATCH]
    payload = json.dumps({'listen_type': 'import', 'payload': [c[1] for c in chunk]}, ensure_ascii=False)
    print('%d\t%d\t%s' % (len(chunk), chunk[-1][0], payload))
PYEOF
)

# tunes scrobble [--dry-run] [--all]
cmd_scrobble() {
  local dry=0 resend=0 a
  for a in "$@"; do
    case "$a" in
      -n|--dry-run) dry=1 ;;
      --all) resend=1 ;;
      *) echo "Usage: tunes scrobble [--dry-run] [--all]   (--all re-sends your whole history)" >&2; return 1 ;;
    esac
  done
  if ((dry == 0)) && [[ -z "$LISTENBRAINZ_TOKEN" ]]; then
    echo "No ListenBrainz token yet. Copy yours from https://listenbrainz.org/settings/ then run:" >&2
    echo "  tunes config set LISTENBRAINZ_TOKEN <token>" >&2
    return 1
  fi
  local cursor_file="$DATA_DIR/.listenbrainz_cursor" cursor=0 batches count max_ts payload sent=0 url errf
  if ((resend == 0)) && [[ -f "$cursor_file" ]]; then cursor=$(cat "$cursor_file" 2>/dev/null || echo 0); fi
  [[ "$cursor" =~ ^[0-9]+$ ]] || cursor=0
  batches=$(TUNES_THRESH="$PLAY_THRESHOLD" TUNES_VERSION="$TUNES_VERSION" python3 -c "$SCROBBLE_PY" "$PLAYS_FILE" "$cursor")
  if [[ -z "$batches" ]]; then echo "Nothing new to submit."; return 0; fi
  url="${LISTENBRAINZ_URL%/}/1/submit-listens"
  errf=$(mktemp)
  while IFS=$'\t' read -r count max_ts payload; do
    if ((dry)); then sent=$((sent + count)); continue; fi
    if ! curl -fsS --max-time 30 -o /dev/null -X POST "$url" \
         -H "Authorization: Token $LISTENBRAINZ_TOKEN" -H "Content-Type: application/json" \
         --data-binary "$payload" 2>"$errf"; then
      echo "✗ ListenBrainz rejected the submission: $(tr '\n' ' ' < "$errf") — check your token (tunes config)." >&2
      rm -f "$errf"
      return 1
    fi
    printf '%s\n' "$max_ts" > "$cursor_file"
    sent=$((sent + count))
  done <<< "$batches"
  rm -f "$errf"
  if ((dry)); then echo "Dry run: $sent listens would be submitted (nothing sent)."
  else echo "✔ Submitted $sent listens to ListenBrainz"; fi
}

# ---------- backup / restore ----------

# tunes backup [dir]  — play log, history, favourites, playlists, podcasts, reports (no API keys)
cmd_backup() {
  local dest="${1:-$DATA_DIR/backups}" keep=10 out items=() f old
  mkdir -p "$dest"
  for f in plays.tsv history.tsv favorites.tsv feeds.tsv podcast_history.tsv playlists reports; do
    [[ -e "$DATA_DIR/$f" ]] && items+=("$f")
  done
  ((${#items[@]})) || { echo "Nothing to back up yet."; return 0; }
  out="$dest/tunes-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
  tar -C "$DATA_DIR" -czf "$out" "${items[@]}"
  echo "✔ Backup saved: $out ($(du -h "$out" | cut -f1))"
  local i=0
  while IFS= read -r old; do
    i=$((i + 1))
    ((i > keep)) && rm -f "$old"
  done < <(ls -1t "$dest"/tunes-backup-*.tar.gz 2>/dev/null || true)
  echo "   Keeping the newest $keep backups. Settings/API keys are not included."
}

# tunes restore <archive> [-y]  — extracts over your data (refuses unsafe paths)
cmd_restore() {
  local arc="${1:-}" yes="${2:-}" entry ans
  [[ -f "$arc" ]] || { echo "Usage: tunes restore <backup.tar.gz> [-y]" >&2; return 1; }
  while IFS= read -r entry; do
    if [[ "$entry" == /* || "/$entry/" == */../* ]]; then echo "Refusing: archive contains an unsafe path ($entry)." >&2; return 1; fi
  done < <(tar -tzf "$arc")
  if [[ "$yes" != "-y" ]]; then
    read -rp "Restore $arc over the data in $DATA_DIR? [y/N] " ans || true
    [[ "$ans" =~ ^[Yy]$ ]] || { echo "Cancelled."; return 0; }
  fi
  mkdir -p "$DATA_DIR"
  tar -C "$DATA_DIR" -xzf "$arc"
  echo "✔ Restored from $arc"
}

# ---------- self-update ----------

# tunes update [--check] [-y]
cmd_update() {
  local check=0 yes=0 a url tmp remote
  for a in "$@"; do
    case "$a" in --check) check=1 ;; -y|--yes) yes=1 ;; *) echo "Usage: tunes update [--check] [-y]" >&2; return 1 ;; esac
  done
  require curl
  url="${TUNES_UPDATE_URL:-https://raw.githubusercontent.com/MelancholicMuser/tunes/main/tunes}"
  tmp=$(mktemp "${TMPDIR:-/tmp}/tunes-update-XXXXXX")
  if ! curl -fsSL --max-time 30 -o "$tmp" "$url"; then
    rm -f "$tmp"; echo "Could not download $url" >&2; return 1
  fi
  remote=$(grep -m1 '^TUNES_VERSION=' "$tmp" | cut -d'"' -f2 || true)
  if [[ "$(head -n1 "$tmp")" != '#!/usr/bin/env bash' ]] || ! [[ "$remote" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || ! bash -n "$tmp" 2>/dev/null; then
    rm -f "$tmp"; echo "The downloaded file does not look like a valid tunes script — not touching your install." >&2; return 1
  fi
  if [[ "$remote" == "$TUNES_VERSION" ]]; then rm -f "$tmp"; echo "✔ tunes $TUNES_VERSION is up to date."; return 0; fi
  if [[ "$(printf '%s\n%s\n' "$remote" "$TUNES_VERSION" | sort -V | tail -n1)" == "$TUNES_VERSION" ]]; then
    rm -f "$tmp"; echo "Your version ($TUNES_VERSION) is newer than the published one ($remote)."; return 0
  fi
  echo "Update available: $TUNES_VERSION → $remote"
  if ((check)); then rm -f "$tmp"; echo "Run: tunes update"; return 0; fi
  if [[ ! -w "$SELF" || ! -w "$(dirname "$SELF")" ]]; then
    rm -f "$tmp"; echo "Cannot write to $SELF — re-run with the right permissions, or reinstall with ./install.sh" >&2; return 1
  fi
  if ((yes == 0)); then
    read -rp "Install $remote to $SELF (a copy of the current one is kept as $SELF.bak)? [y/N] " a || true
    [[ "$a" =~ ^[Yy]$ ]] || { rm -f "$tmp"; echo "Cancelled."; return 0; }
  fi
  cp "$SELF" "$SELF.bak"
  install -m 755 "$tmp" "$SELF.new" && mv "$SELF.new" "$SELF"
  rm -f "$tmp"
  echo "✔ Updated to $remote  (previous version: $SELF.bak)"
}

# ---------- local library ----------

# tunes local [folder]  — browse and play audio files from a folder (default: $MUSIC_DIR)
cmd_local() {
  local dir="${1:-$MUSIC_DIR}" files rows f selections
  [[ -d "$dir" ]] || { echo "Not a folder: $dir   (set yours with: tunes config set MUSIC_DIR ~/Music)" >&2; return 1; }
  files=$(find "$dir" -type f \( -iname '*.mp3' -o -iname '*.flac' -o -iname '*.opus' -o -iname '*.ogg' \
            -o -iname '*.m4a' -o -iname '*.aac' -o -iname '*.wav' -o -iname '*.wma' \) 2>/dev/null \
          | grep -v $'\t' | sort || true)
  [[ -n "$files" ]] || { echo "No audio files found in $dir"; return 0; }
  rows=$(while IFS= read -r f; do printf '%s\t%s\n' "$(basename "${f%.*}")" "$f"; done <<<"$files")
  selections=$(printf '%s\n' "$rows" | fzf --multi --delimiter='\t' --with-nth=1 \
      --prompt="📁 local > " --header="TAB: select several · ENTER: play" \
      --height=70% --border --reverse) || exit 0
  [[ -z "$selections" ]] && exit 0
  play_queue "Local music" "$selections"
}

# ---------- shareable report card ----------

# report_card <period>  — a short plain-text summary you can paste anywhere
report_card() {
  local period="$1" d
  require jq
  d=$(stats_engine json --period "$period")
  if [[ "$(jq -r '.plays' <<<"$d")" == 0 ]]; then echo "No plays logged for '$period' yet."; return 0; fi
  jq -r '
    def clock: (. / 60 | floor) as $m | if $m >= 60 then "\(($m / 60 | floor))h \($m % 60)m" else "\($m)m" end;
    "🎧 My listening · \(.label)",
    "▸ \(.plays) plays · \(.secs | clock) · \(.unique_tracks) tracks · \(.unique_artists) artists",
    (if (.top_tracks | length) > 0 then "▸ Top track: \(.top_tracks[0].title)\(if .top_tracks[0].artist != "" then " — \(.top_tracks[0].artist)" else "" end) (×\(.top_tracks[0].plays))" else empty end),
    (if (.top_artists | length) > 0 then "▸ Top artist: \(.top_artists[0].artist) (×\(.top_artists[0].plays))" else empty end),
    (if (.streak_current // 0) > 1 then "▸ Streak: \(.streak_current) days" else empty end),
    "#tunes"' <<<"$d"
}

# ---------- dispatch ----------

SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"

LOOP=0
SHUFFLE=0
DETACH=0

while [[ "${1:-}" == -* ]]; do
  case "$1" in
    -l|--loop) LOOP=1; shift ;;
    -s|--shuffle) SHUFFLE=1; shift ;;
    -d|--bg|--detach) DETACH=1; shift ;;
    -v|--version) echo "tunes $TUNES_VERSION"; exit 0 ;;
    -h|--help) cmd_help; exit 0 ;;
    *) echo "Unknown flag: $1 (see: tunes help)" >&2; exit 1 ;;
  esac
done
export LOOP SHUFFLE DETACH

cmd="${1:-home}"; shift || true

# Only commands that really need the heavy dependencies / state files ask for them.
case "$cmd" in
  help|version|completion|doctor|config|ai) ;;
  stats|report|ask) require python3; init_state ;;
  ctl|status|np|notify|enhance|sleep|alarm|__sleep_run|__alarm_run) require python3 ;;
  scrobble) require python3 curl; init_state ;;
  backup|restore) init_state ;;
  update) ;;
  local) require mpv fzf python3; init_state ;;
  *) require mpv yt-dlp fzf python3 curl jq; init_state ;;
esac

case "$cmd" in
  home|menu)       cmd_home ;;
  search)          cmd_search "$*" ;;
  bg)              DETACH=1; cmd_search "$*" ;;
  play)            cmd_play "${1:-}" ;;
