# Query playback status and show rich formatted output
cmd_status() {
  if ! mpv_ipc '["get_property", "playback-time"]' 0 >/dev/null 2>&1; then
    echo "Tunes is not currently playing."
    return 0
  fi
  python3 - "$MPV_SOCKET" <<'PYEOF'
import sys, socket, json, signal
signal.signal(signal.SIGPIPE, signal.SIG_DFL)  # no traceback when piped into head/grep -q

def query(prop):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(1.0)
        s.connect(sys.argv[1])
        s.sendall((json.dumps({"command": ["get_property", prop], "request_id": 7}) + "\n").encode('utf-8'))
        buf = b""
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                try:
                    msg = json.loads(line)
                except Exception:
                    continue
                if msg.get("request_id") == 7:
                    s.close()
                    return msg.get("data") if msg.get("error") == "success" else None
        s.close()
    except Exception:
        pass
    return None

title = query("media-title") or "Unknown Track"
artist = query("metadata/by-key/artist") or query("metadata/by-key/uploader") or ""
paused = query("pause")
pos = query("time-pos") or 0.0
dur = query("duration") or 0.0
vol = query("volume") or 100.0
speed = query("speed") or 1.0
loop_file = query("loop-file") or "no"
loop_pl = query("loop-playlist") or "no"

def fmt_time(sec):
    if not sec or sec < 0: return "00:00"
    m, s = divmod(int(sec), 60)
    h, m = divmod(m, 60)
    if h > 0: return f"{h:02d}:{m:02d}:{s:02d}"
    return f"{m:02d}:{s:02d}"

state_str = "⏸ Paused" if paused else "▶ Playing"
time_str = f"{fmt_time(pos)} / {fmt_time(dur)}"

bar = ""
if dur > 0:
    pct = min(1.0, max(0.0, pos / dur))
    w = 20
    filled = int(w * pct)
    b = "=" * filled + (">" if filled < w else "") + "-" * (w - filled - (1 if filled < w else 0))
    bar = f" [{b}] {int(pct*100)}%"

loop_str = "Track" if loop_file in ("inf", "yes") else ("Playlist" if loop_pl in ("inf", "yes") else "Off")

import os
ap_file = os.environ.get("TUNES_AUTOPLAY_FILE") or os.path.expanduser("~/.local/share/tunes/.autoplay_state")
ap_state = "on"
try:
    with open(ap_file) as _f:
        _s = _f.read().strip().lower()
        if _s in ("off", "0", "false"):
            ap_state = "off"
except Exception:
    pass

acodec = query("audio-codec-name")
srate = query("audio-params/samplerate")
channels = query("audio-params/channels")
bitrate = query("audio-bitrate")
af_data = query("af")

q_parts = []
if acodec: q_parts.append(str(acodec).upper())
if srate: q_parts.append(f"{srate/1000:.1f} kHz" if srate >= 1000 else f"{srate} Hz")
if channels: q_parts.append(str(channels).capitalize())
if bitrate and bitrate > 0: q_parts.append(f"~{int(bitrate/1000)} kbps")
stream_str = " • ".join(q_parts)

enh_label = "Off (no filters)"
if isinstance(af_data, list) and len(af_data) > 0:
    enh_names = [f.get("name","") for f in af_data if isinstance(f, dict) and f.get("name")]
    if enh_names:
        enh_label = f"Active ({', '.join(enh_names)})"
elif isinstance(af_data, str) and af_data.strip():
    enh_label = f"Active ({af_data.strip()})"

print("🎵 Tunes Status:")
print(f"  Track:    {title}")
if artist and artist not in title:
    print(f"  Artist:   {artist}")
print(f"  State:    {state_str}")
print(f"  Progress: {time_str}{bar}")
if stream_str:
    print(f"  Quality:  {stream_str}")
print(f"  Enhance:  {enh_label}")
print(f"  Volume:   {int(vol)}%")
print(f"  Speed:    {speed:.2f}x")
print(f"  Loop:     {loop_str}")
print(f"  Autoplay: {ap_state.upper()}")
PYEOF
}

