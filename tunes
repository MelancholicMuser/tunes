cmd_vlc() {
  local query="${1:-}"
  [[ -z "$query" ]] && read -rp "Search (VLC): " query
  [[ -z "$query" ]] && exit 0
  require vlc
  local selection
  selection=$(search_and_pick "$query" | pick_from_list "🟠 VLC > ") || { echo "Cancelled."; exit 0; }
  [[ -z "$selection" ]] && exit 0
  local title url clean resolved ytargs=(-f "bestaudio/best") extra=()
  title=$(cut -f1 <<<"$selection"); url=$(cut -f2 <<<"$selection")
  clean=$(clean_title "$title")
  log_history "$title" "$url"
  [[ -n "$YT_CLIENT" ]] && ytargs+=(--extractor-args "youtube:player_client=$YT_CLIENT")
  echo "Resolving stream URL..."
  resolved=$(yt-dlp "${ytargs[@]}" -g "$url" 2>/dev/null | head -1 || true)
  [[ -z "$resolved" ]] && { echo "Failed to resolve stream."; exit 1; }
  [[ "${LOOP:-0}" == "1" ]] && extra+=(--loop)
  echo "▶ Opening in VLC (plays in VLC are not counted in your stats): $clean"
  vlc --meta-title="$clean" "${extra[@]}" "$resolved" >/dev/null 2>&1 &
  disown
}


# Direct play of URL, audio stream, local file or directory
