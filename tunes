  if [[ -z "$name" ]]; then
    echo "Fetching feed details..." >&2
    name=$(curl -sL --max-time 10 "$url" 2>/dev/null | python3 -c "
import sys, xml.etree.ElementTree as ET
try:
    root = ET.fromstring(sys.stdin.buffer.read())
