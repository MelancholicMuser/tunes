  pod-history)     cmd_podcast_history ;;
  pod-download)    cmd_podcast_download ;;
  recommend)       cmd_recommend "${1:-}" ;;
  mood)            cmd_mood "$*" ;;
  top)             cmd_top "$@" ;;
  forgotten)       cmd_forgotten "$@" ;;
  sleep)           cmd_sleep "${1:-status}" ;;
  alarm)           cmd_alarm "$@" ;;
  scrobble)        cmd_scrobble "$@" ;;
  backup)          cmd_backup "${1:-}" ;;
  restore)         cmd_restore "${1:-}" "${2:-}" ;;
  update)          cmd_update "$@" ;;
  local)           cmd_local "${1:-}" ;;
  __sleep_run)     __sleep_run "${1:-0}" ;;
  __alarm_run)     __alarm_run "${1:-0}" "${2:-}" ;;
  mix)             cmd_mix "${1:-25}" ;;
