  feed_url=$(cut -f2 <<<"$feed_selection")
  echo "Fetching episodes for: $feed_name ..." >&2
  local episodes
  episodes=$(pod_parse_feed "$feed_url" 40 "$feed_name") || true
  [[ -z "$episodes" ]] && { echo "No episodes found."; exit 0; }
  local ep_selection
  ep_selection=$(echo "$episodes" | fzf --delimiter='\t' --with-nth=1,4 --prompt="⬇ Download episode > " --height=60% --border --reverse) || exit 0
  [[ -z "$ep_selection" ]] && exit 0
  local title url target_dir
