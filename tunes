cmd_podcast_add_url() {
  local url="${1:-}" name="${2:-}"
  [[ -z "$url" ]] && read -rp "Podcast RSS URL: " url
  [[ -z "$url" ]] && exit 0
  if [[ -z "$name" ]]; then
    echo "Fetching feed details..." >&2
    name=$(curl -sL --max-time 10 "$url" 2>/dev/null | python3 -c "
import sys, xml.etree.ElementTree as ET
try:
    root = ET.fromstring(sys.stdin.buffer.read())
    t = root.find('.//channel/title')
    print((t.text or '').strip() if t is not None else 'Podcast')
except Exception:
    print('Podcast')
" || echo "Podcast")
  fi
  dedupe_tsv_by_url "$FEEDS_FILE" "$url"
  printf '%s\t%s\n' "$(sanitize_field "$name")" "$url" >> "$FEEDS_FILE"
  echo "✔ Subscribed to: $name ($url)"
  desktop_notify "Podcast Subscribed" "$name" "emblem-favorite"
}

