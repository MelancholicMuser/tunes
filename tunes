cmd_podcast_download() {
  [[ ! -s "$FEEDS_FILE" ]] && { echo "No subscriptions yet. Use: tunes pod-add \"<name>\""; exit 0; }
  local feed_selection feed_name feed_url
  feed_selection=$(fzf --delimiter='\t' --with-nth=1 --prompt="🎙 Download from feed > " --height=60% --border --reverse < "$FEEDS_FILE") || exit 0
  [[ -z "$feed_selection" ]] && exit 0
