# ---------- recommendations ----------

cmd_recommend_music() {
  [[ ! -s "$HISTORY_FILE" ]] && { echo "No listening history yet — play some tracks first."; exit 0; }
  local keywords played
  played=$(cut -f2 "$HISTORY_FILE" | grep -v '^\s*$' || true)

  if ollama_available; then
    echo "Asking Llama 3.2 to read your listening history..." >&2
    local recent; recent=$(cut -f1 "$HISTORY_FILE" | head -n 30)
    local sys="You are a music recommendation assistant. Given a list of recently played track titles, infer the listener's taste (genre, mood, era, artists) and suggest 5 short YouTube search queries for NEW tracks they'd likely enjoy — similar vein, but not the same songs. Reply with ONLY the 5 queries, one per line, no numbering, no explanation."
    local raw; raw=$(llm_ask "$sys" "$recent" 2>/dev/null) || raw=""
    keywords=$(echo "$raw" | llm_lines_to_list 5)
  fi

  if [[ -z "${keywords:-}" ]]; then
    echo "Falling back to keyword analysis of your history..." >&2
    keywords=$(cut -f1 "$HISTORY_FILE" | top_words 3)
  fi
  [[ -z "$keywords" ]] && { echo "Not enough history to build recommendations yet."; exit 0; }

  echo "Based on:"
  echo "$keywords" | sed 's/^/  • /'
  local combined=""
  while IFS= read -r kw; do
    [[ -z "$kw" ]] && continue
    combined+="$(search_and_pick "$kw" 6 || true)"$'\n'
  done <<< "$keywords"

  local filtered
  filtered=$(echo "$combined" | grep -v '^\s*$' | awk -F'\t' '!seen[$2]++')
  if [[ -n "$played" ]]; then
    filtered=$(awk -F'\t' '
      NR==FNR {
        if ($0 != "") seen[$1]=1;
        next
      }
      !seen[$2] { print $0 }
    ' <(echo "$played") <(echo "$filtered"))
  fi
  [[ -z "$filtered" ]] && { echo "Couldn't find fresh recommendations right now."; exit 0; }
  local selection
  selection=$(echo "$filtered" | pick_from_list "✨ Recommended > ") || exit 0
  [[ -z "$selection" ]] && exit 0
  play_url "$(cut -f1 <<<"$selection")" "$(cut -f2 <<<"$selection")"
}

cmd_recommend_podcast() {
  [[ ! -s "$FEEDS_FILE" ]] && { echo "No subscriptions yet. Use: tunes pod-add \"<name>\" first."; exit 0; }
  echo "Checking your subscriptions for unplayed episodes..." >&2
  local played all_new=""
  played=$(cut -f2 "$POD_HISTORY_FILE" 2>/dev/null | grep -v '^\s*$' || true)
  while IFS=$'\t' read -r name url; do
    [[ -z "$url" ]] && continue
    local eps; eps=$(pod_parse_feed "$url" 10 "$name") || true
    while IFS=$'\t' read -r etitle eurl ename epub; do
      [[ -z "$eurl" ]] && continue
      if [[ -n "$played" ]]; then
        grep -qF "$eurl" <<<"$played" && continue
      fi
      all_new+="${etitle}"$'\t'"${eurl}"$'\t'"${ename}"$'\t'"${epub}"$'\n'
    done <<< "$eps"
  done < "$FEEDS_FILE"
  all_new=$(echo "$all_new" | grep -v '^\s*$')
  [[ -z "$all_new" ]] && { echo "You're all caught up — no new episodes."; exit 0; }

  if ollama_available; then
    echo "Asking Llama 3.2 to rank unplayed episodes..." >&2
    local titles_only; titles_only=$(echo "$all_new" | cut -f1)
    local sys="You are a podcast curator. Given a numbered list of unplayed episode titles, pick the 8 most interesting or substantive ones (skip filler/ad/trailer-sounding titles). Reply with ONLY the exact titles you picked, one per line, copied verbatim from the input, no numbering, no commentary."
    local numbered; numbered=$(nl -ba -w1 -s'. ' <<< "$titles_only")
    local raw; raw=$(llm_ask "$sys" "$numbered" 2>/dev/null) || raw=""
    if [[ -n "$raw" ]]; then
      local ranked=""
      while IFS= read -r line; do
        line=$(sed -E 's/^[[:space:]]*[-*0-9.)]+[[:space:]]*//' <<<"$line")
        [[ -z "$line" ]] && continue
        local match; match=$(echo "$all_new" | grep -F "$line" | head -n1)
        [[ -n "$match" ]] && ranked+="$match"$'\n'
      done <<< "$raw"
      [[ -n "$ranked" ]] && all_new="$ranked"
    fi
  fi

  local selection
  selection=$(echo "$all_new" | fzf --delimiter='\t' --with-nth=1,3 --prompt="🎙 recommended > " --height=60% --border --reverse \
      --preview='echo -e "Episode:  \033[1m{1}\033[0m\nDate:     {4}\nFeed:     {3}"' \
      --preview-window="down:3:wrap:hidden" --bind="?:toggle-preview") || exit 0
  [[ -z "$selection" ]] && exit 0
  play_podcast_url "$(cut -f1 <<<"$selection")" "$(cut -f2 <<<"$selection")" "$(cut -f3 <<<"$selection")"
}

cmd_recommend() {
  case "${1:-}" in
    podcast|pod) cmd_recommend_podcast ;;
    music|"")    cmd_recommend_music ;;
    *) echo "Usage: tunes recommend {music|podcast}"; exit 1 ;;
  esac
}

# ---------- natural language / mood search (Ollama) ----------

cmd_mood() {
  local desc="${1:-}"
  [[ -z "$desc" ]] && read -rp "Describe what you want to listen to: " desc
  [[ -z "$desc" ]] && exit 0

  if ! ollama_available; then
    echo "⚠ Ollama not reachable at ${OLLAMA_URL}. Falling back to plain search on: $desc"
    cmd_search "$desc"
    return
  fi

  echo "Thinking about: \"$desc\" ..." >&2
  local sys="You turn a mood or vibe description into good YouTube search queries for music. Reply with ONLY 5 short search queries, one per line, no numbering, no explanation, no quotes."
  local raw; raw=$(llm_ask "$sys" "$desc" 2>/dev/null) || raw=""
  local queries; queries=$(echo "$raw" | llm_lines_to_list 5)
  if [[ -z "$queries" ]]; then
    echo "Model gave no usable output, falling back to plain search."
    cmd_search "$desc"
    return
  fi

  echo "Searching for:"
  echo "$queries" | sed 's/^/  • /'
  local combined=""
  while IFS= read -r q; do
    [[ -z "$q" ]] && continue
    combined+="$(search_and_pick "$q" 6 || true)"$'\n'
  done <<< "$queries"
  combined=$(echo "$combined" | grep -v '^\s*$' | awk -F'\t' '!seen[$2]++')
  [[ -z "$combined" ]] && { echo "No results found."; exit 0; }

  local selections
  selections=$(echo "$combined" | fzf --multi --delimiter='\t' --with-nth=1,3,4 \
      --prompt="🎵 mood: $desc (tab to multi-select) > " --height=60% --border --reverse \
      --preview='echo -e "Title:    \033[1m{1}\033[0m\nChannel:  {3}\nDuration: {4}\nURL:      {2}"' \
      --preview-window="down:4:wrap:hidden" --bind="?:toggle-preview") || exit 0
  [[ -z "$selections" ]] && exit 0

  local playlist_file; playlist_file=$(mktemp /tmp/tunes-mood-XXXX.m3u)
  local count=0
  while IFS=$'\t' read -r title url channel duration; do
    [[ -z "$url" ]] && continue
    local clean; clean=$(clean_title "$title")
    log_history "$title" "$url"
    { echo "#EXTINF:-1,${clean}"; echo "$url"; } >> "$playlist_file"
    count=$((count+1))
  done <<< "$selections"

  cleanup_stale_socket
  local loop_flag="" shuffle_flag=""
  [[ "${LOOP:-0}" == "1" ]] && loop_flag="--loop-playlist=inf"
  [[ "${SHUFFLE:-0}" == "1" ]] && shuffle_flag="--shuffle"
  local script_args; script_args=$(get_mpv_script_args)

  if [[ "${DETACH:-0}" == "1" ]]; then
    echo "▶ Playing mood queue of ${count} tracks in background"
    nohup mpv --no-video --input-ipc-server="$MPV_SOCKET" \
        $script_args $YTDL_ARGS $loop_flag $shuffle_flag "$playlist_file" > "$DATA_DIR/tunes.log" 2>&1 &
    local pid=$!
    disown "$pid"
    desktop_notify "Mood Queue Started" "Playing ${count} tracks" "audio-headphones"
  else
    echo "▶ Playing mood queue of ${count} tracks"
    mpv --no-video --input-ipc-server="$MPV_SOCKET" \
        $script_args $YTDL_ARGS $loop_flag $shuffle_flag --term-osd-bar "$playlist_file"
    rm -f "$playlist_file"
  fi
}

# ---------- listening statistics ----------

cmd_stats() {
  echo "📊 Tunes Listening Statistics"
  echo "=============================="
  local track_count pod_count fav_count feed_count
  track_count=$(wc -l < "$HISTORY_FILE" 2>/dev/null | tr -d ' ' || echo "0")
  pod_count=$(wc -l < "$POD_HISTORY_FILE" 2>/dev/null | tr -d ' ' || echo "0")
  fav_count=$(wc -l < "$FAVORITES_FILE" 2>/dev/null | tr -d ' ' || echo "0")
  feed_count=$(wc -l < "$FEEDS_FILE" 2>/dev/null | tr -d ' ' || echo "0")

  echo "  • Total Music Plays:      $track_count"
  echo "  • Total Podcast Plays:    $pod_count"
  echo "  • Favorite Tracks:        $fav_count"
  echo "  • Subscribed Feeds:       $feed_count"
  echo ""

  if [[ -s "$HISTORY_FILE" ]]; then
    echo "🔥 Top Repeated Tracks:"
    cut -f1 "$HISTORY_FILE" | sort | uniq -c | sort -rn | head -5 | awk '{$1="  " $1 "x"; print}' || true
    echo ""
    echo "🏷 Top Music Keywords / Artists:"
    cut -f1 "$HISTORY_FILE" | top_words 5 | sed 's/^/    • /' || true
  fi
}

cmd_completion() {
  cat <<'EOF'
# Bash completion for tunes
_tunes_completions() {
  local cur prev subcmds ctl_cmds pl_cmds pod_cmds rec_cmds
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  subcmds="search bg play video vlc queue history fav-add favorites fav-remove download lyrics ctl status np notify pod pod-add pod-add-url pod-feeds pod-history pod-download pod-remove recommend mood playlist stats help"
  ctl_cmds="pause play stop next prev vol vol-up vol-down mute seek speed loop-toggle loop-on loop-off status info"
  pl_cmds="list create add play view delete"
  pod_cmds="play add add-url feeds history download remove"
  rec_cmds="music podcast"

  case "$prev" in
    tunes)
      COMPREPLY=( $(compgen -W "$subcmds" -- "$cur") )
      return 0
      ;;
    ctl)
      COMPREPLY=( $(compgen -W "$ctl_cmds" -- "$cur") )
      return 0
      ;;
    playlist)
      COMPREPLY=( $(compgen -W "$pl_cmds" -- "$cur") )
      return 0
      ;;
    pod)
      COMPREPLY=( $(compgen -W "$pod_cmds" -- "$cur") )
      return 0
      ;;
    recommend)
      COMPREPLY=( $(compgen -W "$rec_cmds" -- "$cur") )
      return 0
      ;;
  esac
}
complete -F _tunes_completions tunes
EOF
}

