# ---------- recommendations ----------

cmd_recommend_music() {
  [[ ! -s "$HISTORY_FILE" ]] && { echo "No listening history yet — play some tracks first."; exit 0; }
  local keywords played
  played=$(cut -f2 "$HISTORY_FILE" | grep -v '^\s*$' || true)

  if llm_available; then
    echo "Asking your local model to read your listening history..." >&2
    local recent
    recent=$({ stats_engine top --period all --limit 15 | cut -f1 || true; cut -f1 "$HISTORY_FILE" | awk 'NR <= 15'; } | awk '!s[$0]++')
    local sys="You are a music recommendation assistant. Given a list of recently played track titles, infer the listener's taste (genre, mood, era, artists) and suggest 5 short YouTube search queries for NEW tracks they'd likely enjoy — similar vein, but not the same songs. Reply with ONLY the 5 queries, one per line, no numbering, no explanation."
    local raw; raw=$(llm_ask "$sys" "$recent" 2>/dev/null) || raw=""
    keywords=$(echo "$raw" | llm_lines_to_list 5 || true)
  fi

  if [[ -z "${keywords:-}" ]]; then
    echo "Falling back to keyword analysis of your history..." >&2
    keywords=$(cut -f1 "$HISTORY_FILE" | top_words 3 || true)
  fi
  [[ -z "$keywords" ]] && { echo "Not enough history to build recommendations yet."; exit 0; }

  echo "Based on:"
  echo "$keywords" | sed 's/^/  • /'
  local combined=""
  while IFS= read -r kw; do
    [[ -z "$kw" ]] && continue
    combined+="$(search_and_pick "$kw" 6 || true)"$'\n'
  done <<< "$keywords"

  local filtered
  filtered=$(echo "$combined" | awk -F'\t' 'NF >= 2 && !seen[$2]++')
  if [[ -n "$played" ]]; then
    filtered=$(awk -F'\t' '
      NR==FNR {
        if ($0 != "") seen[$1]=1;
        next
      }
      !seen[$2] { print $0 }
    ' <(echo "$played") <(echo "$filtered"))
  fi
  [[ -z "$filtered" ]] && { echo "Couldn't find fresh recommendations right now."; exit 0; }
  local selection
  selection=$(echo "$filtered" | pick_from_list "✨ Recommended > ") || exit 0
  [[ -z "$selection" ]] && exit 0
  play_url "$(cut -f1 <<<"$selection")" "$(cut -f2 <<<"$selection")"
}

cmd_recommend_podcast() {
  [[ ! -s "$FEEDS_FILE" ]] && { echo "No subscriptions yet. Use: tunes pod-add \"<name>\" first."; exit 0; }
  echo "Checking your subscriptions for unplayed episodes..." >&2
  local played all_new=""
  played=$(cut -f2 "$POD_HISTORY_FILE" 2>/dev/null | grep -v '^\s*$' || true)
  while IFS=$'\t' read -r name url; do
    [[ -z "$url" ]] && continue
    local eps; eps=$(pod_parse_feed "$url" 10 "$name") || true
    while IFS=$'\t' read -r etitle eurl ename epub; do
      [[ -z "$eurl" ]] && continue
      if [[ -n "$played" ]]; then
        grep -qF "$eurl" <<<"$played" && continue
      fi
      all_new+="${etitle}"$'\t'"${eurl}"$'\t'"${ename}"$'\t'"${epub}"$'\n'
    done <<< "$eps"
  done < "$FEEDS_FILE"
  all_new=$(echo "$all_new" | grep -v '^\s*$' || true)
  [[ -z "$all_new" ]] && { echo "You're all caught up — no new episodes."; exit 0; }

  if llm_available; then
    echo "Asking your local model to rank unplayed episodes..." >&2
    local titles_only; titles_only=$(echo "$all_new" | cut -f1)
    local sys="You are a podcast curator. Given a numbered list of unplayed episode titles, pick the 8 most interesting or substantive ones (skip filler/ad/trailer-sounding titles). Reply with ONLY the exact titles you picked, one per line, copied verbatim from the input, no numbering, no commentary."
    local numbered; numbered=$(nl -ba -w1 -s'. ' <<< "$titles_only")
    local raw; raw=$(llm_ask "$sys" "$numbered" 2>/dev/null) || raw=""
    if [[ -n "$raw" ]]; then
      local ranked=""
      while IFS= read -r line; do
        line=$(sed -E 's/^[[:space:]]*[-*0-9.)]+[[:space:]]*//' <<<"$line")
        [[ -z "$line" ]] && continue
        local match; match=$(echo "$all_new" | grep -F "$line" | head -n1 || true)
        [[ -n "$match" ]] && ranked+="$match"$'\n'
      done <<< "$raw"
      [[ -n "$ranked" ]] && all_new="$ranked"
    fi
  fi

  local selection
  selection=$(echo "$all_new" | fzf --delimiter='\t' --with-nth=1,3 --prompt="🎙 recommended > " --height=60% --border --reverse \
      --preview='echo -e "Episode:  \033[1m{1}\033[0m\nDate:     {4}\nFeed:     {3}"' \
      --preview-window="down:3:wrap:hidden" --bind="?:toggle-preview") || exit 0
  [[ -z "$selection" ]] && exit 0
  play_podcast_url "$(cut -f1 <<<"$selection")" "$(cut -f2 <<<"$selection")" "$(cut -f3 <<<"$selection")"
}

cmd_recommend() {
  case "${1:-}" in
    podcast|pod) cmd_recommend_podcast ;;
    music|"")    cmd_recommend_music ;;
    *) echo "Usage: tunes recommend {music|podcast}"; exit 1 ;;
  esac
}

